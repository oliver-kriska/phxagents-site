---
import Default from './Default.astro';
import { getDocsNav } from '../lib/docsNav';
import { hookDocPages, hookDocUrl } from '../lib/hookDocs';

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  active?: string;
}

const { title, description, seoTitle, active = 'docs' } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = getDocsNav();

function sidebarLabel(entryName: string, entryKind: 'skill' | 'agent'): string {
  if (entryKind === 'agent') return entryName;
  return entryName.includes(':') ? '/' + entryName : entryName;
}
---

<Default title={title} description={description} seoTitle={seoTitle} active={active}>
  <div class="docs-shell">
    <button class="docs-nav-trigger btn-ghost" data-docs-nav-toggle type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="docs-sidebar">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <span>Menu</span>
    </button>
    <aside class="docs-nav" id="docs-sidebar" data-docs-nav aria-label="Documentation navigation">
      <div class="docs-nav-head">
        <span class="docs-nav-section">Docs</span>
      </div>
      <div class="docs-nav-group">
        <ul>
          <li><a href="/install/" aria-current={currentPath === '/install/' ? 'page' : undefined}>Install</a></li>
          <li><a href="/compatibility/" aria-current={currentPath === '/compatibility/' ? 'page' : undefined}>Runtime support</a></li>
          <li><a href="/install/amp/" aria-current={currentPath === '/install/amp/' ? 'page' : undefined}>Amp</a></li>
          <li><a href="/install/codex/" aria-current={currentPath === '/install/codex/' ? 'page' : undefined}>Codex</a></li>
          <li><a href="/install/pi/" aria-current={currentPath === '/install/pi/' ? 'page' : undefined}>Pi</a></li>
          <li><a href="/install/opencode/" aria-current={currentPath === '/install/opencode/' ? 'page' : undefined}>OpenCode</a></li>
          <li><a href="/install/dsh/" aria-current={currentPath === '/install/dsh/' ? 'page' : undefined}>DeepSeek Harness</a></li>
          <li><a href="/iron-laws/" aria-current={currentPath === '/iron-laws/' ? 'page' : undefined}>Iron Laws</a></li>
          <li><a href="/hooks/" aria-current={currentPath === '/hooks/' ? 'page' : undefined}>Hooks</a></li>
          {hookDocPages
            .filter((page) => page.slug !== 'overview')
            .map((page) => (
              <li class="docs-nav-child">
                <a
                  href={hookDocUrl(page.slug)}
                  aria-current={currentPath === hookDocUrl(page.slug) ? 'page' : undefined}
                >{page.navLabel}</a>
              </li>
            ))}
          <li><a href="/tidewave-mcp/" aria-current={currentPath === '/tidewave-mcp/' ? 'page' : undefined}>Tidewave MCP</a></li>
          <li><a href="/changelog/" aria-current={currentPath === '/changelog/' ? 'page' : undefined}>Changelog</a></li>
          <li><a href="/catalog/" aria-current={currentPath === '/catalog/' ? 'page' : undefined}>Catalog</a></li>
          <li><a href="/research/" aria-current={currentPath.startsWith('/research/') ? 'page' : undefined}>Research</a></li>
        </ul>
      </div>

      <div class="docs-nav-head">
        <span class="docs-nav-section">Skills</span>
        <a class="docs-nav-all" href="/catalog/?type=skill">All →</a>
      </div>
      {nav.skills.map((group) => (
        <div class="docs-nav-group">
          <h4>{group.label}</h4>
          <ul>
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.href === currentPath ? 'page' : undefined}
                >
                  <code>{sidebarLabel(item.name, 'skill')}</code>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="docs-nav-head">
        <span class="docs-nav-section">Agents</span>
        <a class="docs-nav-all" href="/catalog/?type=agent">All →</a>
      </div>
      {nav.agents.map((group) => (
        <div class="docs-nav-group">
          <h4>{group.label}</h4>
          <ul>
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.href === currentPath ? 'page' : undefined}
                >
                  <code>{item.name}</code>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </aside>
    <div class="docs-main">
      <slot />
    </div>
  </div>
</Default>

<style is:global>
  .docs-shell {
    display: grid;
    grid-template-columns: 244px minmax(0, 1fr);
    gap: 48px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }
  .docs-main { min-width: 0; max-width: 760px; }
  .docs-main:has(.entity-layout),
  .docs-main:has(.upstream-layout) { max-width: none; }

  .docs-nav {
    position: sticky;
    top: calc(var(--nav-h) + 16px);
    align-self: start;
    max-height: calc(100vh - var(--nav-h) - 32px);
    overflow-y: auto;
    padding-right: 8px;
    font-size: 13px;
    scrollbar-width: thin;
  }
  .docs-nav::-webkit-scrollbar { width: 6px; }
  .docs-nav::-webkit-scrollbar-thumb { background: var(--border); border-radius: 999px; }
  .docs-nav-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 22px 0 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }
  .docs-nav-head:first-child { margin-top: 0; }
  .docs-nav-section {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .docs-nav-all {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    text-decoration: none;
  }
  .docs-nav-all:hover { color: var(--accent-fg); }
  .docs-nav-group { margin-bottom: 14px; }
  .docs-nav-group h4 {
    margin: 12px 0 4px;
    font-size: 10.5px;
    font-family: var(--font-mono);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }
  .docs-nav-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .docs-nav-group ul a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    color: var(--fg-soft);
    line-height: 1.4;
    text-decoration: none;
  }
  .docs-nav-group ul a:hover { background: var(--surface-2); color: var(--fg); }
  .docs-nav-group ul a[aria-current="page"] {
    color: var(--accent-fg);
    background: var(--accent-soft);
    font-weight: 500;
  }
  .docs-nav-group ul li.docs-nav-child a {
    padding-left: 22px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .docs-nav-group ul li.docs-nav-child a:hover { color: var(--fg); }
  .docs-nav-group ul li.docs-nav-child a[aria-current="page"] { color: var(--accent-fg); }
  .docs-nav-group ul a code {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: 12px;
    color: inherit;
    font-family: var(--font-mono);
  }

  .docs-nav-trigger {
    display: none;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    align-self: start;
    height: 34px;
    padding: 0 12px;
    font-size: 12.5px;
  }

  @media (max-width: 1024px) {
    .docs-shell {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 32px;
    }
  }
  @media (max-width: 860px) {
    .docs-shell {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .docs-nav-trigger { display: inline-flex; height: 44px; }
    .docs-nav {
      position: fixed;
      inset: var(--nav-h) 0 0 0;
      max-height: none;
      height: auto;
      background: var(--bg);
      border-top: 1px solid var(--border);
      padding: 24px 24px 80px;
      z-index: 60;
      transform: translateX(-100%);
      transition: transform 220ms ease;
      overflow-y: auto;
    }
    .docs-nav[data-open="true"] { transform: translateX(0); }
    .docs-nav-group ul a { min-height: 44px; }
  }
</style>
