---
import { Code } from 'astro-expressive-code/components';

interface Props {
  body: string;
  /** Optional override label for the frame title. */
  title?: string;
}

const { body, title } = Astro.props;

// Extract first ```lang(meta)\n…``` fenced block from raw markdown.
// Also skips frontmatter if present (--- … ---) at the top.
const stripped = body.replace(/^---[\s\S]*?\n---\n?/, '');
const match = stripped.match(/^```([\w-]*)([^\n]*)\n([\s\S]*?)\n```/m);

const lang = match?.[1]?.trim() || 'bash';
const inlineMeta = match?.[2]?.trim() ?? '';
const code = match?.[3] ?? '';

// If caller passed an explicit title, inject it into meta unless already present.
const finalMeta =
  title && !/title\s*=/.test(inlineMeta)
    ? `${inlineMeta} title="${title}"`.trim()
    : inlineMeta;
---

{
  code && (
    <div class="first-fence">
      <Code code={code} lang={lang} meta={finalMeta} />
    </div>
  )
}
