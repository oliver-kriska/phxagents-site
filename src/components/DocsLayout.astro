---
import Default from '../layouts/Default.astro';

interface PagerEntry {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  kind: 'skill' | 'agent';
  name: string;
  slug: string;
  effort?: string;
  argumentHint?: string;
  model?: string;
  tools?: string;
  sourceUrl: string;
  prev?: PagerEntry | null;
  next?: PagerEntry | null;
}

const {
  title,
  description,
  kind,
  name,
  effort,
  argumentHint,
  model,
  tools,
  sourceUrl,
  prev,
  next,
} = Astro.props;
const displayName = kind === 'skill' && name.includes(':') ? '/' + name : name;
function pagerLabel(entryName: string): string {
  if (kind === 'agent') return entryName;
  return entryName.includes(':') ? '/' + entryName : entryName;
}
const synopsis = argumentHint ? `${displayName} ${argumentHint}` : displayName;
const pillKind =
  kind === 'agent'
    ? 'pill-warn'
    : name.startsWith('lv:')
      ? 'pill-violet'
      : name.startsWith('ecto:')
        ? 'pill-info'
        : 'pill-accent';
const modelPillClass =
  model === 'opus' ? 'pill-violet' : model === 'haiku' ? 'pill-info' : 'pill-accent';
const catalogFilter = kind === 'agent' ? '/catalog/?type=agent' : '/catalog/?type=skill';
---

<Default title={title} description={description} active="catalog">
  <div class="docs-shell">
    <main class="docs-main">
      <div class="crumbs">
        <a href="/">phxagents</a>
        <span class="sep">/</span>
        <a href={catalogFilter}>{kind === 'agent' ? 'Agents' : 'Skills'}</a>
        <span class="sep">/</span>
        <span class="mono">{displayName}</span>
      </div>

      <div class="cmd-head">
        <div class="row">
          <span class={`pill ${pillKind}`}><span class="dot"></span>{kind}</span>
          {effort && <span class="pill">effort: {effort}</span>}
          {model && <span class={`pill ${modelPillClass}`}>model: {model}</span>}
        </div>
        <h1>{displayName}</h1>
        {description && <p class="lede">{description}</p>}

        {argumentHint && (
          <div class="synopsis-block">
            <p class="synopsis-label">Synopsis</p>
            <pre class="synopsis">{synopsis}</pre>
          </div>
        )}

        <div class="actions">
          <a class="btn-ghost" href={sourceUrl} rel="noopener">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            View source on GitHub
          </a>
        </div>

        {tools && (
          <div class="meta numeric"><span><b>Tools:</b> <code>{tools}</code></span></div>
        )}
      </div>

      <div class="docs-body">
        <slot />
      </div>

      {(prev || next) && (
        <nav class="pager" aria-label={`${kind === 'agent' ? 'Agent' : 'Skill'} navigation`}>
          {prev ? (
            <a class="pager-link prev" href={prev.href} rel="prev">
              <span class="pager-direction">← Previous</span>
              <span class="pager-name">{pagerLabel(prev.name)}</span>
            </a>
          ) : <span class="pager-spacer" />}
          {next ? (
            <a class="pager-link next" href={next.href} rel="next">
              <span class="pager-direction">Next →</span>
              <span class="pager-name">{pagerLabel(next.name)}</span>
            </a>
          ) : <span class="pager-spacer" />}
        </nav>
      )}
    </main>
  </div>
</Default>

<style>
  .docs-shell {
    max-width: 980px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }
  .docs-main { min-width: 0; max-width: 760px; margin: 0 auto; }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .crumbs .sep { color: var(--border-strong); }
  .crumbs a:hover { color: var(--fg); }

  .cmd-head {
    border-bottom: 1px solid var(--border);
    padding-bottom: 22px;
    margin-bottom: 26px;
  }
  .cmd-head .row {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .cmd-head h1 {
    font-family: var(--font-mono);
    font-size: 30px;
    line-height: 1.1;
    margin: 0;
    color: var(--fg);
    font-weight: 600;
    letter-spacing: -0.015em;
    word-break: break-word;
  }
  .cmd-head .lede {
    margin: 8px 0 0;
    color: var(--fg-soft);
    font-size: 15.5px;
    line-height: 1.55;
    max-width: 640px;
  }
  .cmd-head .meta {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    color: var(--muted);
    font-size: 12.5px;
    font-family: var(--font-mono);
  }
  .cmd-head .meta b { color: var(--fg-soft); font-weight: 500; }
  .cmd-head .actions {
    display: flex; gap: 8px; flex-wrap: wrap;
    margin-top: 16px;
  }
  .synopsis-block { margin-top: 18px; }
  .synopsis-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-family: var(--font-mono);
    margin: 0 0 6px;
  }
  .synopsis {
    font-family: var(--font-mono);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    font-size: 13px;
    color: var(--fg);
    margin: 0;
    overflow-x: auto;
  }

  /* Markdown body */
  .docs-body :global(h1) { display: none; } /* skill bodies have their own H1 — hide; we show our own */
  .docs-body :global(h2) {
    margin: 40px 0 14px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 20px;
    letter-spacing: -0.015em;
    font-weight: 600;
    color: var(--fg);
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .docs-body :global(h3) {
    margin: 24px 0 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--fg);
  }
  .docs-body :global(p) {
    margin: 0 0 14px;
    color: var(--fg-soft);
    line-height: 1.65;
    font-size: 14.5px;
  }
  .docs-body :global(ul), .docs-body :global(ol) {
    margin: 0 0 16px 0;
    padding-left: 22px;
    color: var(--fg-soft);
    font-size: 14.5px;
    line-height: 1.65;
  }
  .docs-body :global(li) { margin: 4px 0; }
  .docs-body :global(a) {
    color: var(--accent-fg);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 40%, transparent);
    text-underline-offset: 2px;
  }
  .docs-body :global(a:hover) { color: var(--accent); }
  .docs-body :global(pre) {
    margin: 14px 0 22px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    font-size: 12.5px;
    line-height: 1.6;
    overflow-x: auto;
  }
  .docs-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 14px 0 22px;
    font-size: 13.5px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .docs-body :global(th), .docs-body :global(td) {
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .docs-body :global(th) {
    font-weight: 500;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--surface-2);
    color: var(--muted);
    font-family: var(--font-mono);
  }
  .docs-body :global(blockquote) {
    margin: 14px 0;
    padding: 12px 16px;
    border-left: 3px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--fg-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  /* Prev/next pager */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 120ms;
    min-width: 0;
  }
  .pager-link:hover { border-color: var(--border-strong); }
  .pager-link.next { text-align: right; }
  .pager-direction {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .pager-name {
    font-family: var(--font-mono);
    color: var(--fg);
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pager-spacer {
    /* keep grid columns balanced when one neighbor is missing */
  }
  @media (max-width: 600px) {
    .pager { grid-template-columns: 1fr; }
    .pager-link.next { text-align: left; }
  }
</style>
