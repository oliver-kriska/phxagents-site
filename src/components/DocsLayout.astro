---
import type { MarkdownHeading } from 'astro';
import DocPage from '../layouts/DocPage.astro';
import PageToc from './PageToc.astro';
import { serpDescription, serpTitle } from '../lib/seo';
import { getSkillIdentity } from '../lib/skillNames';

interface PagerEntry {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  kind: 'skill' | 'agent';
  name: string;
  slug: string;
  effort?: string;
  argumentHint?: string;
  model?: string;
  tools?: string;
  sourceUrl: string;
  dateModified: string;
  headings: MarkdownHeading[];
  prev?: PagerEntry | null;
  next?: PagerEntry | null;
}

const {
  title,
  description,
  kind,
  name,
  slug,
  effort,
  argumentHint,
  model,
  tools,
  sourceUrl,
  dateModified,
  headings,
  prev,
  next,
} = Astro.props;
const skillIdentity = kind === 'skill' ? getSkillIdentity(slug, name) : null;
const displayName = skillIdentity?.isCommand ? '/' + skillIdentity.claudeName : name;
function pagerLabel(entryName: string): string {
  if (kind === 'agent') return entryName;
  return entryName.includes(':') ? '/' + entryName : entryName;
}
const synopsis = argumentHint ? `${displayName} ${argumentHint}` : displayName;
const pillKind =
  kind === 'agent'
    ? 'pill-warn'
    : skillIdentity?.group === 'lv'
      ? 'pill-violet'
      : skillIdentity?.group === 'ecto'
        ? 'pill-info'
        : 'pill-accent';
// Model-tier hues intentionally avoid pill-violet: that hue already means
// "lv:" namespace on skill pages (see pillKind above), and reusing it here
// for "opus" would let the same color mean two unrelated things sitewide.
const modelPillClass =
  model === 'opus' ? 'pill-warn' : model === 'haiku' ? 'pill-info' : 'pill-accent';
const catalogFilter = kind === 'agent' ? '/catalog/?type=agent' : '/catalog/?type=skill';
const markdownUrl = `/${kind === 'agent' ? 'agents' : 'skills'}/${slug}.md`;
const generatedName = skillIdentity?.portableName ?? name.replace(/:/g, '-');
const runtimeInvocations = kind === 'skill' ? [
  {
    name: 'Claude Code',
    href: '/install/#claude-code',
    command: skillIdentity?.isCommand ? `/${skillIdentity.claudeName}` : `use ${name}`,
  },
  {
    name: 'Amp',
    href: '/install/amp/',
    command: `skill: invoke → ${generatedName}`,
  },
  {
    name: 'Codex',
    href: '/install/codex/',
    command: `$elixir-phoenix:${generatedName}`,
  },
  {
    name: 'Pi',
    href: '/install/pi/',
    command: `/skill:${generatedName}`,
  },
  {
    name: 'OpenCode',
    href: '/install/opencode/',
    command: `skill tool → name: "${generatedName}"`,
  },
  {
    name: 'DeepSeek Harness',
    href: '/install/dsh/',
    command: `/${generatedName}`,
  },
] : [];

// Structured data: breadcrumb trail + a per-entity TechArticle so each skill/agent
// is a distinct entity. Mirrors the visible crumbs and the SoftwareApplication
// schema on the homepage.
const sectionName = kind === 'agent' ? 'Agents' : 'Skills';
const pageUrl = `https://phxagents.dev/${kind === 'agent' ? 'agents' : 'skills'}/${slug}/`;
const detailJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'phxagents', item: 'https://phxagents.dev/' },
        { '@type': 'ListItem', position: 2, name: sectionName, item: `https://phxagents.dev${catalogFilter}` },
        { '@type': 'ListItem', position: 3, name: displayName, item: pageUrl },
      ],
    },
    {
      '@type': 'TechArticle',
      '@id': `${pageUrl}#${kind}`,
      headline: displayName,
      name: displayName,
      ...(description ? { description } : {}),
      url: pageUrl,
      inLanguage: 'en',
      dateModified,
      author: { '@type': 'Person', name: 'Oliver Kriška', url: 'https://github.com/oliver-kriska' },
      publisher: { '@id': 'https://phxagents.dev/#org' },
      isPartOf: { '@id': 'https://phxagents.dev/#website' },
    },
  ],
};
---

<!-- The lede and the JSON-LD below keep the plugin's raw description; only the
     search snippet is rewritten for a human reader (see ../lib/seo.ts). -->
<DocPage
  title={title}
  description={description && serpDescription(description)}
  seoTitle={serpTitle(displayName, kind)}
  active="catalog"
>
  <script type="application/ld+json" set:html={JSON.stringify(detailJsonLd)} />
  <div class="crumbs">
    <a href="/">phxagents</a>
    <span class="sep">/</span>
    <a href={catalogFilter}>{kind === 'agent' ? 'Agents' : 'Skills'}</a>
    <span class="sep">/</span>
    <span class="mono">{displayName}</span>
  </div>

  <div class="cmd-head">
    <div class="row">
      <span class={`pill ${pillKind}`}><span class="dot"></span>{kind}</span>
      {effort && <span class="pill">effort: {effort}</span>}
      {model && <span class={`pill ${modelPillClass}`}>model: {model}</span>}
    </div>
    <h1>{displayName}</h1>
    {description && <p class="lede">{description}</p>}

    {argumentHint && (
      <div class="synopsis-block">
        <p class="synopsis-label">Synopsis</p>
        <pre class="synopsis">{synopsis}</pre>
      </div>
    )}

    {kind === 'skill' && (
      <section class="runtime-invocations" aria-labelledby="invoke-heading">
        <div class="runtime-invocations-head">
          <h2 id="invoke-heading">Invoke in v3</h2>
          <a href="/compatibility/">Compare runtime support →</a>
        </div>
        <div class="runtime-invocation-grid">
          {runtimeInvocations.map((runtime) => (
            <a href={runtime.href} class="runtime-invocation">
              <span>{runtime.name}</span>
              <code>{runtime.command}</code>
            </a>
          ))}
        </div>
        <p class="runtime-note">Claude Code includes the full custom-agent and hook layer. Generated runtimes load the same skill knowledge with runtime-native invocation.</p>
      </section>
    )}

    <div class="actions">
      <a class="btn-ghost" href={markdownUrl}>View as Markdown</a>
      <a class="btn-ghost" href={sourceUrl} rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        View source on GitHub
      </a>
    </div>

    {tools && (
      <div class="meta numeric"><span><b>Tools:</b> <code>{tools}</code></span></div>
    )}
  </div>

  <div class="entity-layout">
    <div class="entity-content">
      <PageToc headings={headings} variant="mobile" />

      <div class="docs-body">
        <slot />
      </div>

      {(prev || next) && (
        <nav class="pager" aria-label={`${kind === 'agent' ? 'Agent' : 'Skill'} navigation`}>
          {prev ? (
            <a class="pager-link prev" href={prev.href} rel="prev">
              <span class="pager-direction">← Previous</span>
              <span class="pager-name">{pagerLabel(prev.name)}</span>
            </a>
          ) : <span class="pager-spacer" />}
          {next ? (
            <a class="pager-link next" href={next.href} rel="next">
              <span class="pager-direction">Next →</span>
              <span class="pager-name">{pagerLabel(next.name)}</span>
            </a>
          ) : <span class="pager-spacer" />}
        </nav>
      )}
    </div>

    <PageToc headings={headings} variant="desktop" />
  </div>
</DocPage>

<style>
  .entity-layout {
    display: grid;
    grid-template-columns: minmax(0, 720px) 180px;
    gap: 32px;
    align-items: start;
  }
  .entity-content { min-width: 0; }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .crumbs .sep { color: var(--border-strong); }
  .crumbs a:hover { color: var(--fg); }

  .cmd-head {
    border-bottom: 1px solid var(--border);
    padding-bottom: 22px;
    margin-bottom: 26px;
  }
  .cmd-head .row {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .cmd-head h1 {
    font-family: var(--font-mono);
    font-size: 30px;
    line-height: 1.1;
    margin: 0;
    color: var(--fg);
    font-weight: 600;
    letter-spacing: -0.015em;
    word-break: break-word;
  }
  .cmd-head .lede {
    margin: 8px 0 0;
    color: var(--fg-soft);
    font-size: 15.5px;
    line-height: 1.55;
    max-width: 640px;
  }
  .cmd-head .meta {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    color: var(--muted);
    font-size: 12.5px;
    font-family: var(--font-mono);
  }
  .cmd-head .meta b { color: var(--fg-soft); font-weight: 500; }
  .cmd-head .actions {
    display: flex; gap: 8px; flex-wrap: wrap;
    margin-top: 16px;
  }
  .synopsis-block { margin-top: 18px; }
  .synopsis-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-family: var(--font-mono);
    margin: 0 0 6px;
  }
  .synopsis {
    font-family: var(--font-mono);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    font-size: 13px;
    color: var(--fg);
    margin: 0;
    overflow-x: auto;
  }
  .runtime-invocations {
    margin-top: 20px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .runtime-invocations-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
  }
  .runtime-invocations-head h2 {
    margin: 0;
    color: var(--fg);
    font: 600 11px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .runtime-invocations-head a {
    color: var(--muted);
    font-size: 11.5px;
  }
  .runtime-invocations-head a:hover { color: var(--accent-fg); }
  .runtime-invocation-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .runtime-invocation {
    min-width: 0;
    padding: 10px;
    border-right: 1px solid var(--border);
    text-decoration: none;
    transition: background 120ms;
  }
  .runtime-invocation:last-child { border-right: 0; }
  .runtime-invocation:hover { background: var(--accent-soft); color: inherit; }
  .runtime-invocation span {
    display: block;
    margin-bottom: 5px;
    color: var(--muted);
    font: 500 10.5px/1.4 var(--font-mono);
  }
  .runtime-invocation code {
    display: block;
    padding: 0;
    color: var(--fg);
    background: none;
    border: 0;
    font-size: 10.5px;
    line-height: 1.45;
    overflow-wrap: anywhere;
    white-space: normal;
  }
  .runtime-note {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.5;
  }

  /* Markdown body — headings are shifted +1 at render time (rehypeShiftHeadings
     in astro.config.mjs) so the layout title above is the page's only visible
     <h1>. The body's own "# Title" becomes <h2>, its "##" sections become
     <h3>, its "###" subsections become <h4>. Selectors below mirror that +1.
     The <h2> duplicates the layout's <h1> visually, so it's hidden the
     screen-reader-only way (clipped, not display:none) — display:none would
     also remove it from the accessibility tree and leave heading navigation
     skipping straight from H1 to H3 on every skill/agent page. */
  .docs-body :global(h2) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .docs-body :global(h3) {
    margin: 40px 0 14px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 20px;
    letter-spacing: -0.015em;
    font-weight: 600;
    color: var(--fg);
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .docs-body :global(h4) {
    margin: 24px 0 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--fg);
  }
  .docs-body :global(p) {
    margin: 0 0 14px;
    color: var(--fg-soft);
    line-height: 1.65;
    font-size: 14.5px;
  }
  .docs-body :global(ul), .docs-body :global(ol) {
    margin: 0 0 16px 0;
    padding-left: 22px;
    color: var(--fg-soft);
    font-size: 14.5px;
    line-height: 1.65;
  }
  .docs-body :global(li) { margin: 4px 0; }
  .docs-body :global(a) {
    color: var(--accent-fg);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 40%, transparent);
    text-underline-offset: 2px;
  }
  .docs-body :global(a:hover) { color: var(--accent); }
  .docs-body :global(pre) {
    margin: 14px 0 22px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    font-size: 12.5px;
    line-height: 1.6;
    overflow-x: auto;
  }
  .docs-body :global(.table-wrap) {
    margin: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-inline: contain;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .docs-body :global(.table-region) { margin: 14px 0 22px; }
  .docs-body :global(table) {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    margin: 0;
    font-size: 13.5px;
  }
  .docs-body :global(th), .docs-body :global(td) {
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .docs-body :global(th) {
    font-weight: 500;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--surface-2);
    color: var(--muted);
    font-family: var(--font-mono);
  }
  .docs-body :global(blockquote) {
    margin: 14px 0;
    padding: 12px 16px;
    border-left: 3px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--fg-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 640px;
  }

  /* Cap prose measure (~72ch, matches the lede) for readability. pre/table and
     the h3 section-divider rules deliberately keep the full content width. */
  .docs-body :global(p),
  .docs-body :global(ul),
  .docs-body :global(ol) { max-width: 640px; }

  /* Copy buttons on rendered code blocks + the synopsis (injected by site.js,
     so the controls match the hand-authored install/index pages). */
  .docs-body :global(pre) { position: relative; }
  .docs-body :global(pre.has-copy) { padding-right: 58px; }
  .synopsis { position: relative; }
  .synopsis.has-copy { padding-right: 58px; }
  :global(.code-copy) {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 3px 8px;
    font: 500 11px/1 var(--font-mono);
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 120ms, border-color 120ms;
  }
  :global(.code-copy:hover) { color: var(--fg); border-color: var(--border-strong); }

  /* Heading anchors for deep-linking sections (ids emitted at build). */
  .docs-body :global(h3), .docs-body :global(h4) { position: relative; }
  :global(.heading-anchor) {
    margin-left: 8px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 400;
    opacity: 0;
    transition: opacity 120ms;
  }
  :global(.docs-body h3:hover .heading-anchor),
  :global(.docs-body h4:hover .heading-anchor),
  :global(.heading-anchor:focus-visible) { opacity: 1; }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 120ms;
    min-width: 0;
  }
  .pager-link:hover { border-color: var(--border-strong); }
  .pager-link.next { text-align: right; }
  .pager-direction {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .pager-name {
    font-family: var(--font-mono);
    color: var(--fg);
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pager-spacer {}
  @media (max-width: 1180px) {
    .entity-layout { display: block; }
    .entity-content { max-width: 760px; }
  }
  @media (max-width: 900px) {
    :global(.code-copy) {
      top: 4px;
      right: 4px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      padding: 0;
    }
  }
  @media (max-width: 600px) {
    .synopsis {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .runtime-invocations { padding: 12px; }
    .runtime-invocations-head { align-items: flex-start; flex-direction: column; gap: 4px; }
    .runtime-invocation-grid { grid-template-columns: 1fr; }
    .runtime-invocation {
      display: grid;
      grid-template-columns: 80px minmax(0, 1fr);
      align-items: center;
      gap: 12px;
      min-height: 52px;
      padding: 10px 12px;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .runtime-invocation:last-child { border-bottom: 0; }
    .runtime-invocation span { margin: 0; font-size: 12px; }
    .runtime-invocation code { font-size: 12px; line-height: 1.5; }
    .pager { grid-template-columns: 1fr; }
    .pager-link.next { text-align: left; }
  }
</style>
