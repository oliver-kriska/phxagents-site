---
import Default from '@astrojs/starlight/components/Head.astro';
import { ogHead } from '../lib/ogMeta';

const { entry } = Astro.locals.starlightRoute;
const path = Astro.url.pathname.replace(/\/$/, '').replace(/^\//, '') || 'index';

// Map URL paths to OG endpoint slugs.
// /skills/foo → skills/foo, /agents/bar → agents/bar, / → index, /install → install
const ogSlug = path;

const title = entry.data.title ?? 'phxagents';
const description = entry.data.description ?? undefined;

const extraHead = ogHead({ slug: ogSlug, title, description });

// Merge: render Default first (uses route's own head array, which already has
// title/description meta), then append our OG block. Duplicates are harmless —
// Twitter/OG scrapers take the first occurrence.
---

<Default><slot /></Default>
{extraHead.map(({ tag: Tag, attrs }) => <Tag {...attrs} />)}
