---
import { getEntry, render } from 'astro:content';
import DocPage from '../layouts/DocPage.astro';
import PageToc from './PageToc.astro';
import { getPluginSourceDate } from '../lib/sourceDates';

interface Props {
  entryId: string;
  /** Which upstream collection backs this page. */
  collection?: 'upstreamDocs' | 'hookDocs';
  /**
   * Path of the backing file inside the plugin repository, used for the
   * "View source" link and the git-derived dateModified. Runtime guides all
   * live in docs/; hook docs are scattered, so they pass their own path.
   */
  sourcePath?: string;
  title: string;
  description: string;
  pageUrl: string;
  breadcrumb: string;
  /** Sidebar highlight group. */
  active?: string;
  wide?: boolean;
}

const {
  entryId,
  collection = 'upstreamDocs',
  sourcePath: sourcePathProp,
  title,
  description,
  pageUrl,
  breadcrumb,
  active = 'runtimes',
  wide = false,
} = Astro.props;

const sourcePath = sourcePathProp ?? `docs/${entryId}.md`;
const entry = await getEntry(collection, entryId);

if (!entry) {
  throw new Error(
    `Missing canonical upstream documentation at plugin-source/${sourcePath}. Clone or link the plugin source before building.`
  );
}

const { Content, headings } = await render(entry);
const sourceUrl = `https://github.com/oliver-kriska/claude-elixir-phoenix/blob/main/${sourcePath}`;
const dateModified = getPluginSourceDate(
  sourcePath,
  entry.data.dateModified ?? entry.data.updated ?? entry.data.date
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'phxagents', item: 'https://phxagents.dev/' },
        { '@type': 'ListItem', position: 2, name: breadcrumb, item: pageUrl },
      ],
    },
    {
      '@type': 'TechArticle',
      '@id': `${pageUrl}#article`,
      headline: title,
      name: title,
      description,
      url: pageUrl,
      inLanguage: 'en',
      dateModified,
      author: { '@type': 'Person', name: 'Oliver Kriška', url: 'https://github.com/oliver-kriska' },
      publisher: { '@id': 'https://phxagents.dev/#org' },
      isPartOf: { '@id': 'https://phxagents.dev/#website' },
    },
  ],
};
---

<DocPage title={breadcrumb} seoTitle={`${title} — phxagents`} description={description} active={active}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="page-head">
    <div>
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
    <a class="btn-ghost" href={sourceUrl} rel="noopener">View source</a>
  </div>
  <div class:list={["upstream-layout", { wide }]}>
    <div class="upstream-content">
      <PageToc headings={headings} variant="mobile" forceVisible={wide} />
      {Astro.slots.has('intro') && (
        <div class="page-intro">
          <slot name="intro" />
        </div>
      )}
      <div class:list={["docs-body", { wide }]}>
        <Content />
      </div>
    </div>
    {!wide && <PageToc headings={headings} variant="desktop" />}
  </div>
</DocPage>

<style>
  .page-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin: 0 0 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .page-head h1 {
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 600;
    color: var(--fg);
    text-wrap: balance;
  }
  .page-head p {
    margin: 8px 0 0;
    color: var(--fg-soft);
    font-size: 15px;
    line-height: 1.55;
    max-width: 640px;
  }
  .page-head .btn-ghost { flex: none; }
  .upstream-layout {
    display: grid;
    grid-template-columns: minmax(0, 720px) 180px;
    gap: 32px;
    align-items: start;
  }
  .upstream-layout.wide { display: block; }
  .upstream-content { min-width: 0; }
  .page-intro {
    max-width: 680px;
    margin: 0 0 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }
  .page-intro :global(h2) {
    margin: 0 0 10px;
    color: var(--fg);
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .page-intro :global(h3) {
    margin: 24px 0 8px;
    color: var(--fg);
    font-size: 15px;
    line-height: 1.4;
  }
  .page-intro :global(p) {
    max-width: 680px;
    margin: 0 0 14px;
    color: var(--fg-soft);
    font-size: 14.5px;
    line-height: 1.65;
  }
  .page-intro :global(p:last-child) { margin-bottom: 0; }
  .docs-body { max-width: 720px; }
  .docs-body.wide { max-width: 920px; }
  .docs-body :global(h2:first-child) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .docs-body :global(h3) {
    margin: 40px 0 14px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 20px;
    letter-spacing: -0.015em;
    font-weight: 600;
    color: var(--fg);
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .docs-body :global(h4) {
    margin: 24px 0 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--fg);
  }
  .docs-body :global(p) {
    margin: 0 0 14px;
    color: var(--fg-soft);
    line-height: 1.65;
    font-size: 14.5px;
    max-width: 680px;
  }
  .docs-body :global(ul), .docs-body :global(ol) {
    margin: 0 0 16px;
    padding-left: 22px;
    color: var(--fg-soft);
    font-size: 14.5px;
    line-height: 1.65;
    max-width: 680px;
  }
  .docs-body :global(li) { margin: 4px 0; }
  .docs-body :global(a) {
    color: var(--accent-fg);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 40%, transparent);
    text-underline-offset: 2px;
  }
  .docs-body :global(a:hover) { color: var(--accent); }
  .docs-body :global(pre) {
    position: relative;
    margin: 14px 0 22px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    font-size: 12.5px;
    line-height: 1.6;
    overflow-x: auto;
  }
  .docs-body :global(pre.has-copy) { padding-right: 58px; }
  .docs-body :global(blockquote) {
    margin: 14px 0 22px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--info);
    border-radius: var(--radius);
    background: var(--info-soft);
    color: var(--fg-soft);
  }
  .docs-body :global(blockquote p:last-child) { margin-bottom: 0; }
  .docs-body :global(.table-wrap) {
    margin: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-inline: contain;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .docs-body :global(.table-region) { margin: 14px 0 22px; }
  .docs-body :global(table) {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    margin: 0;
    font-size: 13.5px;
  }
  .docs-body.wide :global(table) { min-width: 820px; }
  .docs-body :global(th), .docs-body :global(td) {
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .docs-body :global(th) {
    font-weight: 500;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--surface-2);
    color: var(--muted);
    font-family: var(--font-mono);
  }
  .docs-body :global(tr:last-child td) { border-bottom: 0; }
  .docs-body :global(h3), .docs-body :global(h4) { position: relative; }
  :global(.heading-anchor) {
    margin-left: 8px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 400;
    opacity: 0;
    transition: opacity 120ms;
  }
  :global(.docs-body h3:hover .heading-anchor),
  :global(.docs-body h4:hover .heading-anchor),
  :global(.heading-anchor:focus-visible) { opacity: 1; }
  :global(.code-copy) {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 3px 8px;
    font: 500 11px/1 var(--font-mono);
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 120ms, border-color 120ms;
  }
  :global(.code-copy:hover) { color: var(--fg); border-color: var(--border-strong); }
  @media (max-width: 1180px) {
    .upstream-layout { display: block; }
    .upstream-content:not(:has(.docs-body.wide)) { max-width: 760px; }
  }
  @media (max-width: 900px) {
    :global(.code-copy) {
      top: 4px;
      right: 4px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      padding: 0;
    }
  }
  @media (max-width: 600px) {
    .page-head { display: block; }
    .page-head .btn-ghost { margin-top: 16px; min-height: 44px; }
  }
</style>
