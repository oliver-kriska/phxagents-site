---
import { getLatestRelease } from '../data/release';

const release = await getLatestRelease();

const formatDate = (iso: string) => {
  try {
    return new Date(iso).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
  } catch {
    return iso;
  }
};

// First non-empty line of release body, max 240 chars
const summarize = (body: string): string => {
  if (!body) return '';
  const firstParagraph = body
    .split('\n\n')
    .map((p) => p.trim())
    .find((p) => p.length > 0 && !p.startsWith('#'));
  if (!firstParagraph) return '';
  const single = firstParagraph.replace(/\s+/g, ' ').trim();
  return single.length > 240 ? single.slice(0, 237) + '…' : single;
};
---

{
  release ? (
    <aside class="release-widget">
      <div class="release-meta">
        <span class="release-tag">Latest · {release.tag_name}</span>
        <span class="release-date">{formatDate(release.published_at)}</span>
      </div>
      {release.name && release.name !== release.tag_name && (
        <h3 class="release-name">{release.name}</h3>
      )}
      {summarize(release.body) && (
        <p class="release-summary">{summarize(release.body)}</p>
      )}
      <a class="release-link" href={release.html_url}>
        Read release notes →
      </a>
    </aside>
  ) : null
}
