---
import { getCollection } from 'astro:content';
import { featuredSkills, featuredAgents } from '../data/featured';

const skills = await getCollection('skills');
const agents = await getCollection('agents');

const featuredSkillEntries = featuredSkills
  .map((name) => skills.find((s) => s.data.name === name))
  .filter(Boolean) as typeof skills;

const featuredAgentEntries = featuredAgents
  .map((name) => agents.find((a) => a.data.name === name))
  .filter(Boolean) as typeof agents;

function skillSlug(id: string) {
  return id.replace(/\/skill$/i, '');
}
---

<section class="featured-section">
  <h2>Start with these</h2>
  <p class="featured-sub">
    Four core workflow skills and four flagship orchestrators. Browse
    <a href="/skills/">all {skills.length} skills</a> or
    <a href="/agents/">all {agents.length} agents</a>.
  </p>

  <h3 class="featured-group-label">Workflow skills</h3>
  <div class="featured-grid">
    {
      featuredSkillEntries.map((entry) => (
        <a class="featured-card" href={`/skills/${skillSlug(entry.id)}/`}>
          <span class="featured-card-name">{entry.data.name}</span>
          <span class="featured-card-desc">{entry.data.description}</span>
          <span class="featured-card-arrow">→</span>
        </a>
      ))
    }
  </div>

  <h3 class="featured-group-label">Orchestrators &amp; reviewers</h3>
  <div class="featured-grid">
    {
      featuredAgentEntries.map((entry) => (
        <a class="featured-card" href={`/agents/${entry.id}/`}>
          <span class="featured-card-name">{entry.data.name}</span>
          <span class="featured-card-desc">{entry.data.description}</span>
          <span class="featured-card-arrow">→</span>
        </a>
      ))
    }
  </div>
</section>
