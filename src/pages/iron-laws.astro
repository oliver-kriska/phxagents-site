---
import fs from 'node:fs';
import path from 'node:path';
import DocPage from '../layouts/DocPage.astro';
import { stats } from '../data/stats';
import { marked } from 'marked';

const ROOT = process.cwd();
const CLAUDE_MD = path.join(ROOT, 'plugin-source', 'CLAUDE.md');

let section = '';
try {
  const content = fs.readFileSync(CLAUDE_MD, 'utf-8');
  const start = content.indexOf('## Iron Laws Enforcement');
  if (start !== -1) {
    const rest = content.slice(start);
    const nextHeading = rest.slice(1).match(/\n## (?!#)/);
    section = nextHeading ? rest.slice(0, nextHeading.index! + 1) : rest;
  }
} catch {
  section = '';
}

// Parse the derived section into structured laws so the page can regroup them
// by category. The plugin's CLAUDE.md appends laws chronologically, which
// otherwise renders as repeated "### Ecto Iron Laws (continued)" headings and
// single-item lists. Regrouping yields one clean section per category. Content
// stays fully derived — every number, title, and body comes from plugin source.
interface Law { n: number; titleHtml: string; bodyHtml: string }
interface Category { label: string; slug: string; laws: Law[] }

const normalizeCategory = (raw: string): string =>
  raw.replace(/\(continued\)/i, '').replace(/iron laws?/i, '').trim();
const slugify = (s: string): string =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const laws: Law[] = [];
const order: string[] = [];
const byCat = new Map<string, Law[]>();
let current = '';
let violationSrc = '';
let inViolation = false;

for (const line of section.split('\n')) {
  const head = line.match(/^###\s+(.*)$/);
  if (head) {
    const label = head[1].trim();
    if (/violation response/i.test(label)) { inViolation = true; continue; }
    inViolation = false;
    current = normalizeCategory(label);
    continue;
  }
  if (inViolation) { violationSrc += line + '\n'; continue; }
  const m = line.match(/^(\d+)\.\s+\*\*(.+?)\*\*\s*[-–—]?\s*(.*)$/);
  if (m && current) {
    const law: Law = {
      n: Number(m[1]),
      titleHtml: marked.parseInline(m[2].trim()) as string,
      bodyHtml: m[3] ? (marked.parseInline(m[3].trim()) as string) : '',
    };
    laws.push(law);
    if (!byCat.has(current)) { byCat.set(current, []); order.push(current); }
    byCat.get(current)!.push(law);
  }
}

const categories: Category[] = order.map((label) => ({
  label,
  slug: slugify(label),
  laws: byCat.get(label)!,
}));

const parsed = laws.length > 0;
// Fallback to the raw rendered section if upstream format ever drifts.
const fallbackHtml = parsed ? '' : await marked.parse(section || '## Iron Laws\n\nNot available.');
const violationHtml = violationSrc.trim() ? await marked.parse(violationSrc.trim()) : '';
---

<DocPage title="Iron Laws" description={`${stats.ironLaws} non-negotiable rules enforced by the phxagents plugin.`} active="iron-laws">
  <div class="page-head">
    <h1>Iron Laws</h1>
    <p class="lede">
      <strong>{stats.ironLaws} non-negotiable rules</strong> extracted from production Phoenix codebases. Each rule prevents a class of bugs that tests rarely catch. When code would violate a law, the plugin <strong>stops and explains</strong> before proceeding.
    </p>
    <p class="lede">
      Defined in <a href="https://github.com/oliver-kriska/claude-elixir-phoenix/blob/main/CLAUDE.md" rel="noopener">CLAUDE.md</a> in the plugin repo and inlined into every relevant skill.
    </p>
  </div>

  {parsed ? (
    <>
      <nav class="law-index" aria-label="Iron Law categories">
        {categories.map((c) => (
          <a href={`#${c.slug}`}>
            {c.label}
            <span class="law-index-count">{c.laws.length}</span>
          </a>
        ))}
      </nav>
      <p class="law-index-note">Badge numbers are each law's position in the full {stats.ironLaws}-law list, so they run in order overall but not always within a single category.</p>

      {categories.map((c) => (
        <section class={`law-cat${c.laws.length === 1 ? ' law-cat--single' : ''}`} id={c.slug} aria-labelledby={`${c.slug}-h`}>
          <h2 class="law-cat-head" id={`${c.slug}-h`}>
            {c.label}
            <span class="law-cat-count">{c.laws.length} {c.laws.length === 1 ? 'law' : 'laws'}</span>
          </h2>
          <ol class="law-list">
            {c.laws.map((law) => (
              <li class="law" id={`law-${law.n}`}>
                <a class="law-num" href={`#law-${law.n}`} aria-label={`Law ${law.n}, permalink`}>
                  {String(law.n).padStart(2, '0')}
                </a>
                <div class="law-text">
                  <p class="law-title" set:html={law.titleHtml}></p>
                  {law.bodyHtml && <p class="law-desc" set:html={law.bodyHtml}></p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}

      {violationHtml && (
        <aside class="law-violation" aria-label="Violation response">
          <h2>When a law would be violated</h2>
          <div set:html={violationHtml}></div>
        </aside>
      )}
    </>
  ) : (
    <article class="docs-body" set:html={fallbackHtml}></article>
  )}
</DocPage>

<style>
  .page-head h1 {
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
    font-weight: 600;
    color: var(--fg);
  }
  .page-head .lede {
    margin: 0 0 14px;
    color: var(--fg-soft);
    font-size: 15px;
    line-height: 1.6;
    max-width: 640px;
  }
  .page-head .lede:last-child {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 28px;
  }

  /* Category index — wayfinding across all laws */
  .law-index {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 40px;
  }
  .law-index a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--fg-soft);
    text-decoration: none;
    transition: color 120ms, border-color 120ms, background 120ms;
  }
  .law-index a:hover {
    color: var(--fg);
    border-color: var(--border-strong);
    background: var(--surface-2);
  }
  .law-index-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .law-index-note {
    margin: -28px 0 40px;
    font-size: 12.5px;
    color: var(--muted);
    max-width: 560px;
  }

  /* Category section */
  .law-cat { scroll-margin-top: calc(var(--nav-h) + 20px); }
  .law-cat + .law-cat { margin-top: 40px; }
  .law-cat + .law-cat.law-cat--single { margin-top: 24px; }
  .law-cat-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 14px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 20px;
    letter-spacing: -0.015em;
    font-weight: 600;
    color: var(--fg);
  }
  /* Single-law categories (Verification, Code Style) don't need the same
     heavy section chrome as multi-law ones — a full-weight divider + heading
     for one list item reads as broken rhythm, not emphasis. */
  .law-cat--single .law-cat-head {
    padding-top: 10px;
    margin-bottom: 8px;
    font-size: 16px;
  }
  .law-cat-count {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  /* Laws */
  .law-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .law {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 16px;
    padding: 14px 12px 14px 0;
    border-radius: var(--radius);
    scroll-margin-top: calc(var(--nav-h) + 20px);
  }
  .law + .law { border-top: 1px solid var(--border); }
  .law:target {
    background: var(--accent-soft);
    padding-left: 12px;
  }
  .law-num {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
    transition: color 120ms;
  }
  .law-num:hover,
  .law-num:focus-visible { color: var(--accent-fg); }
  .law-text { min-width: 0; }
  .law-title {
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.45;
  }
  .law-desc {
    margin: 0;
    font-size: 14px;
    color: var(--fg-soft);
    line-height: 1.6;
  }
  .law-title :global(code),
  .law-desc :global(code) {
    font-size: 0.9em;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  /* Violation response callout */
  .law-violation {
    margin: 48px 0 0;
    padding: 20px 22px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .law-violation h2 {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 600;
    color: var(--fg);
  }
  .law-violation :global(p) {
    margin: 0 0 12px;
    color: var(--fg-soft);
    font-size: 14px;
    line-height: 1.6;
  }
  .law-violation :global(pre) {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    font-size: 12.5px;
    line-height: 1.55;
    overflow-x: auto;
  }
  .law-violation :global(code) { font-family: var(--font-mono); }

  @media (max-width: 560px) {
    .law { grid-template-columns: 1.9rem minmax(0, 1fr); gap: 12px; }
  }

  /* Fallback path (only used if upstream parsing fails) */
  .docs-body :global(h1), .docs-body :global(h2) {
    margin: 40px 0 14px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 20px;
    letter-spacing: -0.015em;
    font-weight: 600;
    color: var(--fg);
  }
  .docs-body :global(h3) {
    margin: 24px 0 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--fg);
  }
  .docs-body :global(p) {
    margin: 0 0 14px;
    color: var(--fg-soft);
    line-height: 1.65;
    font-size: 14.5px;
  }
  .docs-body :global(ul), .docs-body :global(ol) {
    margin: 0 0 16px 0;
    padding-left: 22px;
    color: var(--fg-soft);
    font-size: 14.5px;
    line-height: 1.65;
  }
  .docs-body :global(li) { margin: 4px 0; }
  .docs-body :global(pre) {
    margin: 14px 0 22px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    font-size: 12.5px;
    overflow-x: auto;
  }
  .docs-body :global(code) {
    font-size: 0.92em;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
</style>
