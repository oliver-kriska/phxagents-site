---
import Default from '../layouts/Default.astro';
import { getCollection } from 'astro:content';
import { getSkillIdentity } from '../lib/skillNames';
import { getAddonAgents, getAddonSkills } from '../lib/addonEntries';
import { getCatalogPlugins, getPlugin } from '../lib/plugins';
import { getLatestPluginSourceDate } from '../lib/sourceDates';

const skills = await getCollection('skills');
const agents = await getCollection('agents');
const [addonSkills, addonAgents] = await Promise.all([getAddonSkills(), getAddonAgents()]);
const corePlugin = getPlugin('elixir-phoenix');

interface Item {
  type: 'skill' | 'agent';
  group: string;
  /** Marketplace id; add-on cards also show it as a tag. */
  plugin: string;
  /** Final display form, with the leading slash for commands. */
  display?: string;
  name: string;
  desc: string;
  slug: string;
}

const items: Item[] = [
  ...skills.map((entry): Item => {
    const slug = entry.id.replace(/\/SKILL$/i, '');
    const identity = getSkillIdentity(slug, entry.data.name);
    return {
      type: 'skill',
      group: identity.group,
      plugin: corePlugin.id,
      name: identity.claudeName,
      desc: entry.data.description,
      slug: `/skills/${slug}/`,
    };
  }),
  ...agents.map((entry): Item => ({
    type: 'agent',
    group: 'agent',
    plugin: corePlugin.id,
    name: entry.data.name,
    desc: entry.data.description,
    slug: `/agents/${entry.id}/`,
  })),
  // Add-on plugins' entries. Their reference skills share the `reference`
  // namespace chip and their agents the `agents` one; commands sit under the
  // plugin's own id, which only the plugin filter selects.
  ...[...addonSkills, ...addonAgents].map((entry): Item => ({
    type: entry.kind,
    group: entry.kind === 'agent' ? 'agent' : entry.isCommand ? entry.plugin.id : 'reference',
    plugin: entry.plugin.id,
    name: entry.isCommand ? entry.displayName.slice(1) : entry.displayName,
    display: entry.displayName,
    desc: entry.description,
    slug: entry.url,
  })),
].sort((a, b) => a.name.localeCompare(b.name));

const pluginFilters = [corePlugin, ...getCatalogPlugins()].map((plugin) => ({
  id: plugin.id,
  // Marketplace ids, as in `/plugin install`, so the core plugin's chip is
  // not a second "phx" next to the phx: namespace chip below.
  label: plugin.id,
  title: plugin.displayName,
  count: items.filter((i) => i.plugin === plugin.id).length,
}));

const counts = {
  all: items.length,
  skill: items.filter((i) => i.type === 'skill').length,
  agent: items.filter((i) => i.type === 'agent').length,
  phx: items.filter((i) => i.group === 'phx').length,
  lv: items.filter((i) => i.group === 'lv').length,
  ecto: items.filter((i) => i.group === 'ecto').length,
  reference: items.filter((i) => i.group === 'reference').length,
};

function pillClass(group: string): string {
  if (group === 'phx') return 'accent';
  if (group === 'lv') return 'violet';
  if (group === 'ecto') return 'info';
  if (group === 'agent') return 'warn';
  return '';
}

function displayName(item: Item): string {
  if (item.display) return item.display;
  if (item.type === 'agent') return item.name;
  if (item.name.includes(':')) return '/' + item.name;
  return item.name;
}
---

<Default title="Catalog" dateModified={getLatestPluginSourceDate(['plugins/*/skills/*', 'plugins/*/agents/*'])} description={`All ${items.length} skills and Claude Code agents across the ${pluginFilters.length} phxagents marketplace plugins.`} active="catalog">
  <div class="catalog-shell" data-catalog>
    <div class="catalog-head">
      <div>
        <h1>Catalog</h1>
        <p>Skills and Claude Code agents across <a href="/plugins/">{pluginFilters.length} plugins</a>. <a href="/compatibility/">Compare runtime support →</a></p>
      </div>
      <div class="summary">
        <b><span data-catalog-count aria-live="polite">{items.length}</span></b>
        shown · {items.length} total
      </div>
    </div>

    <div class="catalog-controls">
      <div class="catalog-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" placeholder={`Search ${items.length} skills and agents…`} data-catalog-search aria-label="Search skills and agents" autocomplete="off" spellcheck="false" />
      </div>

      <div class="filter-group" role="radiogroup" aria-label="Filter by type">
        <button class="filter-chip" role="radio" data-filter-group="type" data-catalog-filter="all" aria-checked="true" tabindex="0">All <span class="count">{counts.all}</span></button>
        <button class="filter-chip" role="radio" data-filter-group="type" data-catalog-filter="skill" aria-checked="false" tabindex="-1">Skills <span class="count">{counts.skill}</span></button>
        <button class="filter-chip" role="radio" data-filter-group="type" data-catalog-filter="agent" aria-checked="false" tabindex="-1">Agents <span class="count">{counts.agent}</span></button>
      </div>
      <button class="catalog-clear" data-catalog-clear type="button" hidden>Clear</button>
    </div>

    <div class="cat-bar" role="radiogroup" aria-label="Filter by plugin">
      <button class="cat-chip" role="radio" data-filter-group="plugin" data-catalog-filter="all" aria-checked="true" tabindex="0">All plugins ({items.length})</button>
      {pluginFilters.map((plugin) => (
        <button class="cat-chip" role="radio" data-filter-group="plugin" data-catalog-filter={plugin.id} aria-checked="false" tabindex="-1" title={plugin.title}>{plugin.label} ({plugin.count})</button>
      ))}
    </div>

    <div class="cat-bar" role="radiogroup" aria-label="Filter by namespace">
      <button class="cat-chip" role="radio" data-filter-group="group" data-catalog-filter="all" aria-checked="true" tabindex="0">All namespaces</button>
      {counts.phx > 0 && <button class="cat-chip" role="radio" data-filter-group="group" data-catalog-filter="phx" aria-checked="false" tabindex="-1">phx: ({counts.phx})</button>}
      {counts.lv > 0 && <button class="cat-chip" role="radio" data-filter-group="group" data-catalog-filter="lv" aria-checked="false" tabindex="-1">lv: ({counts.lv})</button>}
      {counts.ecto > 0 && <button class="cat-chip" role="radio" data-filter-group="group" data-catalog-filter="ecto" aria-checked="false" tabindex="-1">ecto: ({counts.ecto})</button>}
      {counts.reference > 0 && <button class="cat-chip" role="radio" data-filter-group="group" data-catalog-filter="reference" aria-checked="false" tabindex="-1">reference ({counts.reference})</button>}
      {counts.agent > 0 && <button class="cat-chip" role="radio" data-filter-group="group" data-catalog-filter="agent" aria-checked="false" tabindex="-1">agents ({counts.agent})</button>}
    </div>

    <div class="catalog-grid" id="catalog-grid">
      {items.map((item) => (
        <a
          class="catalog-card"
          href={item.slug}
          data-catalog-item
          data-type={item.type}
          data-group={item.group}
          data-plugin={item.plugin}
          data-search={`${item.name} ${item.desc} ${item.group} ${item.plugin}`.toLowerCase()}
        >
          <div class="row">
            {item.plugin === corePlugin.id ? (
              <span class={`pill pill-${pillClass(item.group)}`}>{item.type === 'agent' ? 'agent' : item.group}</span>
            ) : (
              <>
                <span class={`pill pill-${item.type === 'agent' ? 'warn' : ''}`}>{item.type === 'agent' ? 'agent' : item.group === 'reference' ? 'reference' : 'skill'}</span>
                <span class="pill plugin-tag">{getPlugin(item.plugin).prefix}</span>
              </>
            )}
          </div>
          <div class="name">{displayName(item)}</div>
          <div class="desc">{item.desc}</div>
        </a>
      ))}
    </div>

    <div class="catalog-empty" data-catalog-empty style="display:none">
      No skills or agents match your filters.<br />
      Try a different term, or
      <button class="catalog-clear-link" data-catalog-clear type="button">clear all filters</button>.
    </div>
  </div>
</Default>

<script>
  (function () {
    const found = document.querySelector('[data-catalog]');
    if (!found) return;
    // Hoisted function declarations below don't inherit the null check.
    const catalog: Element = found;
    const search = catalog.querySelector('[data-catalog-search]') as HTMLInputElement;
    const filters = catalog.querySelectorAll('[data-catalog-filter]');
    const items = Array.from(catalog.querySelectorAll('[data-catalog-item]')) as HTMLElement[];
    const count = catalog.querySelector('[data-catalog-count]');
    const empty = catalog.querySelector('[data-catalog-empty]') as HTMLElement | null;
    let activeType = 'all';
    let activeGroup = 'all';
    let activePlugin = 'all';

    function setPressed(group: string, value: string) {
      catalog.querySelectorAll(`[data-filter-group="${group}"]`).forEach((b) => {
        const el = b as HTMLElement;
        const selected = el.dataset.catalogFilter === value;
        el.setAttribute('aria-checked', selected ? 'true' : 'false');
        el.tabIndex = selected ? 0 : -1;
        // Reveal deep-linked selections in the phone's scrollable filter rows
        // without moving focus or scrolling the page down to the filters.
        if (selected && el.parentElement?.classList.contains('cat-bar')) {
          el.parentElement.scrollLeft = el.offsetLeft - 4;
        }
      });
    }

    function update() {
      const q = (search.value || '').trim().toLowerCase();
      let shown = 0;
      items.forEach((it) => {
        const t = it.dataset.type!;
        const g = it.dataset.group!;
        const p = it.dataset.plugin!;
        const text = it.dataset.search!;
        const matchType = activeType === 'all' || activeType === t;
        const matchGroup = activeGroup === 'all' || activeGroup === g;
        const matchPlugin = activePlugin === 'all' || activePlugin === p;
        const matchSearch = !q || text.indexOf(q) >= 0;
        const visible = matchType && matchGroup && matchPlugin && matchSearch;
        it.style.display = visible ? '' : 'none';
        if (visible) shown++;
      });
      if (count) count.textContent = String(shown);
      if (empty) empty.style.display = shown === 0 ? '' : 'none';
      const rawQ = (search.value || '').trim();
      const anyActive =
        activeType !== 'all' || activeGroup !== 'all' || activePlugin !== 'all' || rawQ.length > 0;
      const clearBtn = catalog.querySelector('.catalog-clear') as HTMLElement | null;
      if (clearBtn) clearBtn.hidden = !anyActive;
      // Reflect filter state in the URL so a filtered view is shareable.
      const url = new URL(window.location.href);
      const setParam = (k: string, v: string) => {
        if (v && v !== 'all') url.searchParams.set(k, v);
        else url.searchParams.delete(k);
      };
      setParam('type', activeType);
      setParam('group', activeGroup);
      setParam('plugin', activePlugin);
      setParam('q', rawQ);
      history.replaceState(null, '', url.pathname + url.search + url.hash);
    }

    function clearAll() {
      activeType = 'all';
      activeGroup = 'all';
      activePlugin = 'all';
      search.value = '';
      setPressed('type', 'all');
      setPressed('group', 'all');
      setPressed('plugin', 'all');
      update();
      search.focus();
    }

    // URL deep-link: ?type=skill&group=phx&plugin=rewrite&q=plan
    const params = new URLSearchParams(window.location.search);
    const initialType = (params.get('type') || 'all').toLowerCase();
    const initialGroup = params.get('group') || 'all';
    const initialPlugin = params.get('plugin') || 'all';
    const initialQ = params.get('q') || '';
    if (['all', 'skill', 'agent'].includes(initialType)) {
      activeType = initialType;
      setPressed('type', initialType);
    }
    if (initialGroup !== 'all') {
      const exists = catalog.querySelector(`[data-filter-group="group"][data-catalog-filter="${initialGroup}"]`);
      if (exists) {
        activeGroup = initialGroup;
        setPressed('group', initialGroup);
      }
    }
    if (initialPlugin !== 'all') {
      const exists = catalog.querySelector(`[data-filter-group="plugin"][data-catalog-filter="${CSS.escape(initialPlugin)}"]`);
      if (exists) {
        activePlugin = initialPlugin;
        setPressed('plugin', initialPlugin);
      }
    }
    if (initialQ) search.value = initialQ;

    function selectFilter(el: HTMLElement) {
      const group = el.dataset.filterGroup!;
      const value = el.dataset.catalogFilter!;
      setPressed(group, value);
      if (group === 'type') activeType = value;
      else if (group === 'group') activeGroup = value;
      else if (group === 'plugin') activePlugin = value;
      update();
    }

    search.addEventListener('input', update);
    filters.forEach((btn) => {
      btn.addEventListener('click', () => selectFilter(btn as HTMLElement));
    });

    // WAI-ARIA radiogroup pattern: arrow keys move focus AND select; Home/End
    // jump to the first/last radio in the group.
    catalog.querySelectorAll('[role="radiogroup"]').forEach((group) => {
      group.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        const radios = Array.from(group.querySelectorAll('[role="radio"]')) as HTMLElement[];
        const current = document.activeElement as HTMLElement;
        const idx = radios.indexOf(current);
        if (idx === -1) return;
        let next: HTMLElement | null = null;
        if (key === 'ArrowRight' || key === 'ArrowDown') next = radios[(idx + 1) % radios.length];
        else if (key === 'ArrowLeft' || key === 'ArrowUp') next = radios[(idx - 1 + radios.length) % radios.length];
        else if (key === 'Home') next = radios[0];
        else if (key === 'End') next = radios[radios.length - 1];
        if (next) {
          e.preventDefault();
          next.focus();
          selectFilter(next);
        }
      });
    });

    catalog.querySelectorAll('[data-catalog-clear]').forEach((b) => b.addEventListener('click', clearAll));
    update();
  })();
</script>

<style>
  .catalog-shell {
    max-width: var(--container);
    margin: 0 auto;
    padding: 36px 24px 64px;
  }

  .catalog-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .catalog-head h1 {
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 600;
    color: var(--fg);
  }
  .catalog-head p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14.5px;
    max-width: 540px;
  }
  .catalog-head .summary {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
    text-align: right;
    flex: none;
  }
  .catalog-head .summary b { color: var(--fg); font-weight: 600; font-size: 22px; display: block; }

  .catalog-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .catalog-search {
    position: relative;
    flex: 1;
    min-width: 240px;
  }
  .catalog-search svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
  }
  .catalog-search input {
    width: 100%;
    height: 38px;
    padding: 0 12px 0 36px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 14px;
    outline: 0;
    color: var(--fg);
    transition: border-color 120ms;
  }
  .catalog-search input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 18%, transparent);
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .filter-chip {
    height: 30px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    color: var(--fg-soft);
    font-size: 12.5px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .filter-chip:hover { color: var(--fg); }
  .filter-chip[aria-checked="true"] {
    background: var(--surface);
    color: var(--fg);
    box-shadow: var(--shadow-sm);
  }
  .filter-chip .count {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    padding: 0 4px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    margin-left: 4px;
  }

  .cat-bar {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  .cat-chip {
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg-soft);
    font-size: 12px;
    font-family: var(--font-mono);
    cursor: pointer;
  }
  .cat-chip:hover { border-color: var(--border-strong); color: var(--fg); }
  .cat-chip[aria-checked="true"] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }
  .catalog-card {
    padding: 16px 18px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color 120ms;
    text-decoration: none;
    color: inherit;
  }
  @media (hover: hover) and (pointer: fine) {
    .catalog-card:hover { border-color: var(--border-strong); }
  }
  .catalog-card .row { display: flex; align-items: center; gap: 8px; }
  /* Which add-on plugin an entry ships in; phx entries carry no tag. */
  .catalog-card .plugin-tag { font-family: var(--font-mono); }
  .catalog-card .name {
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--fg);
    font-weight: 600;
    word-break: break-word;
  }
  .catalog-card .desc {
    color: var(--fg-soft);
    font-size: 13px;
    line-height: 1.55;
    margin: 2px 0 0;
  }

  .catalog-empty {
    padding: 48px 16px;
    text-align: center;
    color: var(--muted);
    font-size: 14px;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }

  .catalog-clear {
    height: 38px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--fg-soft);
    font-size: 13px;
    cursor: pointer;
    flex: none;
    transition: border-color 120ms, color 120ms;
  }
  .catalog-clear:hover { border-color: var(--border-strong); color: var(--fg); }
  .catalog-clear[hidden] { display: none; }

  .catalog-clear-link {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--accent-fg);
    text-decoration: underline;
    cursor: pointer;
  }
  .catalog-clear-link:hover { text-decoration: none; }

  @media (max-width: 560px) {
    .catalog-shell { padding-top: 24px; }
    .catalog-head {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      margin-bottom: 16px;
      padding-bottom: 16px;
    }
    .catalog-head .summary { text-align: left; }
    .catalog-head .summary b { display: inline; font-size: inherit; }
    .catalog-controls { gap: 8px; margin-bottom: 12px; }
    .catalog-controls .filter-group { flex: 1; min-width: 0; }
    .filter-chip { flex: 1; justify-content: center; padding-inline: 8px; }
    .filter-chip .count { display: none; }
    .catalog-search { flex-basis: 100%; min-width: 0; }
    .catalog-search input { height: 44px; font-size: 16px; }
    .catalog-clear { height: 44px; }
    .cat-bar {
      flex-wrap: nowrap;
      overflow-x: auto;
      position: relative;
      gap: 8px;
      padding: 4px 4px 12px;
      margin: 0 -4px 12px;
      scroll-padding-inline: 4px;
    }
    .cat-chip { flex: none; white-space: nowrap; }
  }

  @media (max-width: 900px) {
    .filter-chip { height: 44px; }
    .cat-chip { height: 44px; padding: 0 14px; }
  }
</style>
