---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const skills = await getCollection('skills');

const sorted = skills
  .map((entry) => ({
    slug: entry.id.replace(/\/skill$/i, ''),
    name: entry.data.name,
    description: entry.data.description,
    effort: entry.data.effort,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const grouped: Record<string, typeof sorted> = {};
for (const skill of sorted) {
  const prefix = skill.name.includes(':') ? skill.name.split(':')[0] : 'reference';
  (grouped[prefix] ||= []).push(skill);
}

const groupOrder = ['phx', 'lv', 'ecto', 'reference'];
const groups = groupOrder
  .filter((g) => grouped[g])
  .map((g) => ({ key: g, items: grouped[g]! }));
---

<StarlightPage
  frontmatter={{
    title: `${sorted.length} Skills`,
    description: 'All skills in the phxagents plugin, grouped by namespace.',
  }}
>
  <p>
    Skills auto-load when you're working on matching files. <code>phx:</code>{' '}
    skills are workflow commands. <code>lv:</code>, <code>ecto:</code> are domain
    helpers. Unprefixed skills are reference knowledge that loads on file open.
  </p>

  {
    groups.map(({ key, items }) => (
      <section>
        <h2>
          <code>{key}</code> · {items.length}{' '}
          {items.length === 1 ? 'skill' : 'skills'}
        </h2>
        <ul>
          {items.map((s) => (
            <li>
              <a href={`/skills/${s.slug}/`}>
                <strong>{s.name}</strong>
              </a>
              {s.effort && (
                <span style="opacity: 0.6"> · effort: {s.effort}</span>
              )}
              <br />
              <span style="opacity: 0.85">{s.description}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</StarlightPage>
