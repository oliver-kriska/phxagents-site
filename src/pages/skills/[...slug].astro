---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../components/DocsLayout.astro';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  const sorted = [...skills].sort((a, b) =>
    a.data.name.localeCompare(b.data.name)
  );
  return sorted.map((entry, idx) => {
    const prev = idx > 0 ? sorted[idx - 1] : null;
    const next = idx < sorted.length - 1 ? sorted[idx + 1] : null;
    return {
      params: { slug: entry.id.replace(/\/SKILL$/i, '') },
      props: {
        entry,
        prev: prev
          ? {
              name: prev.data.name,
              slug: prev.id.replace(/\/SKILL$/i, ''),
            }
          : null,
        next: next
          ? {
              name: next.data.name,
              slug: next.id.replace(/\/SKILL$/i, ''),
            }
          : null,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { name, description, effort } = entry.data;
const rawHint = entry.data['argument-hint'];
const argumentHint = Array.isArray(rawHint)
  ? `[${rawHint.join('|')}]`
  : typeof rawHint === 'string'
  ? rawHint
  : rawHint != null
  ? String(rawHint)
  : undefined;
const slug = entry.id.replace(/\/SKILL$/i, '');
const sourceUrl = `https://github.com/oliver-kriska/claude-elixir-phoenix/blob/main/plugins/elixir-phoenix/skills/${slug}/SKILL.md`;
const prevNav = prev ? { name: prev.name, href: `/skills/${prev.slug}/` } : null;
const nextNav = next ? { name: next.name, href: `/skills/${next.slug}/` } : null;
---

<DocsLayout
  title={name}
  description={description}
  kind="skill"
  name={name}
  slug={slug}
  effort={effort}
  argumentHint={argumentHint}
  sourceUrl={sourceUrl}
  prev={prevNav}
  next={nextNav}
>
  <Content />
</DocsLayout>
