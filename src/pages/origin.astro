---
import Default from '../layouts/Default.astro';
import { origin } from '../data/origin';
import { Marked } from 'marked';

/**
 * The origin essay. Unlike the research report next door — 80 KB of hand-written
 * HTML because it is chart-heavy — this piece is 4,900 words of narrative, so the
 * page renders `src/data/origin.md` rather than restating it. There is no figure
 * here that the Markdown does not carry, which is why no parity check guards it.
 *
 * `renderBody` has already dropped the leading H1 so the hero below owns the only
 * <h1>; the source's `##` sections therefore land at the right level with no
 * heading shift. `/origin.md` still serves the file whole.
 */

const pageUrl = 'https://phxagents.dev/origin/';
const markdownUrl = '/origin.md';

const slugify = (text: string): string =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

interface Section {
  id: string;
  text: string;
}
const sections: Section[] = [];

// Local Marked instance so the shared parser used by iron-laws.astro is untouched.
// Slugs come from the raw `token.text`, not the rendered HTML: parsing first turns
// an apostrophe into `&#39;` and would leave `-39-` in every id that has one.
const marked = new Marked({
  renderer: {
    heading(token) {
      const html = this.parser.parseInline(token.tokens);
      const id = slugify(token.text);
      if (token.depth === 2) sections.push({ id, text: token.text });
      return `<h${token.depth} id="${id}">${html}</h${token.depth}>\n`;
    },
    // Intrinsic dimensions so the lead image reserves its own space
    // and keeps its 16:9 ratio instead of stretching to the column.
    image(token) {
      const alt = token.text ?? '';
      return `<img src="${token.href}" alt="${alt}" width="1672" height="941" decoding="async" />`;
    },
  },
});
const html = await marked.parse(origin.renderBody);

const wordCount = origin.body.trim().split(/\s+/).length;
const readMinutes = Math.round(wordCount / 220);
const publishedLabel = new Date(`${origin.datePublished}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'phxagents', item: 'https://phxagents.dev/' },
        { '@type': 'ListItem', position: 2, name: origin.name, item: pageUrl },
      ],
    },
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: origin.headline,
      name: origin.headline,
      description: origin.description,
      url: pageUrl,
      inLanguage: 'en',
      datePublished: origin.datePublished,
      dateModified: origin.datePublished,
      wordCount,
      author: { '@type': 'Person', name: 'Oliver Kriška', url: 'https://github.com/oliver-kriska' },
      publisher: { '@id': 'https://phxagents.dev/#org' },
      isPartOf: { '@id': 'https://phxagents.dev/#website' },
      about: ['Elixir', 'Phoenix', 'Claude Code', 'AI coding agents', 'phxagents'],
    },
  ],
};
---

<Default
  title={origin.title}
  description={origin.description}
  seoTitle={origin.seoTitle}
  active="origin"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="essay">
    <header class="es-hero">
      <div class="wrap">
        <div class="es-hero-in">
          <p class="es-eyebrow">Origin story</p>
          <h1>{origin.headline}</h1>
          <p class="es-standfirst">{origin.description}</p>
          <div class="es-meta">
            <span><time datetime={origin.datePublished}>{publishedLabel}</time></span>
            <span class="numeric">{origin.sample}</span>
            <span>~{readMinutes} min read</span>
          </div>
          <div class="es-actions">
            <a class="btn-ghost" href={markdownUrl}>View as Markdown</a>
          </div>
        </div>

        <div class="es-stats numeric">
          {origin.heroStats.map((stat) => (
            <div class="es-stat">
              <div class={`n c-${stat.tone}`}>{stat.value}</div>
              <div class="lbl">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </header>

    <div class="wrap">
      <div class="es-shell">
        <nav class="es-toc" aria-label="Contents">
          <details class="es-toc-box" open>
            <summary>Contents</summary>
            <ol>
              {sections.map((section) => (
                <li><a href={`#${section.id}`}>{section.text}</a></li>
              ))}
            </ol>
          </details>
        </nav>

        <div class="es-main">
          <div class="docs-body origin-body" set:html={html}></div>
        </div>
      </div>
    </div>
  </article>
</Default>

<style>
  /* ===========================================================
     Origin essay — long-form narrative on the site's tokens.
     Scoped under .essay; the rendered Markdown needs :global().
     =========================================================== */
  .essay {
    /* Same text-safe semantics as the research report: --danger/--warn from
       global.css are tuned for fills, and at essay body sizes they need a
       darker light value and a lighter dark value to clear WCAG AA. */
    --es-good: var(--accent-fg);
    --es-warn: var(--warn-fg);
    --es-crit: oklch(45% 0.19 25);
  }
  :global([data-theme='dark']) .essay {
    --es-crit: oklch(78% 0.15 25);
  }
  .essay .c-good { color: var(--es-good); }
  .essay .c-warn { color: var(--es-warn); }
  .essay .c-crit { color: var(--es-crit); }

  /* ---------- hero ---------- */
  .es-hero {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    padding: 56px 0 40px;
  }
  .es-hero-in {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 72ch;
  }
  .es-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .es-hero h1 {
    margin: 0;
    font-size: clamp(30px, 4.4vw, 50px);
    line-height: 1.06;
    letter-spacing: -0.028em;
    font-weight: 600;
    color: var(--fg);
    text-wrap: balance;
  }
  .es-standfirst {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--fg-soft);
  }
  .es-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    padding-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .es-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .es-actions .btn-ghost { color: var(--fg); text-decoration: none; }
  .es-actions .btn-ghost:hover { border-color: var(--border-strong); }

  .es-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    overflow: hidden;
  }
  .es-stat {
    padding: 20px 22px 22px;
    border-right: 1px solid var(--border);
  }
  .es-stat:last-child { border-right: 0; }
  .es-stat .n {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .es-stat .lbl {
    margin-top: 6px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--fg-soft);
  }

  /* ---------- shell + contents ---------- */
  .es-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    padding: 0 0 40px;
  }
  .es-main { min-width: 0; }
  .es-toc { padding: 24px 0 0; }
  .es-toc-box {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .es-toc-box > summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    cursor: pointer;
    color: var(--fg);
    font: 600 11px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    list-style: none;
  }
  .es-toc-box > summary::-webkit-details-marker { display: none; }
  .es-toc-box > summary::after {
    content: '+';
    margin-left: auto;
    font-size: 16px;
    font-weight: 400;
    color: var(--muted);
  }
  .es-toc-box[open] > summary::after { content: '−'; }
  .es-toc ol {
    list-style: none;
    counter-reset: es-toc;
    margin: 0;
    padding: 4px 8px 10px;
    border-top: 1px solid var(--border);
  }
  .es-toc a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-height: 40px;
    padding: 8px;
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.4;
    text-decoration: none;
  }
  .es-toc a::before {
    counter-increment: es-toc;
    content: counter(es-toc, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--border-strong);
    flex: none;
  }
  .es-toc a:hover { background: var(--surface-2); color: var(--fg); }
  .es-toc a[aria-current='true'] {
    color: var(--accent-fg);
    background: var(--accent-soft);
    border-left-color: var(--accent);
    font-weight: 500;
  }
  .es-toc a[aria-current='true']::before { color: var(--accent); }

  @media (min-width: 1000px) {
    .es-shell {
      grid-template-columns: 250px minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }
    .es-toc {
      position: sticky;
      top: calc(var(--nav-h) + 24px);
      max-height: calc(100vh - var(--nav-h) - 48px);
      overflow-y: auto;
      padding: 52px 0 0;
    }
    .es-toc-box { border: 0; background: transparent; }
    .es-toc-box > summary { pointer-events: none; padding: 0 0 6px; min-height: 0; }
    .es-toc-box > summary::after,
    .es-toc-box[open] > summary::after { content: ''; }
    .es-toc ol { padding: 0; border-top: 0; }
    .es-toc a { min-height: 0; padding: 6px 9px; }
  }

  /* ---------- rendered essay ---------- */
  .origin-body {
    max-width: 68ch;
    padding: 44px 0 0;
    font-size: 16px;
    line-height: 1.72;
    color: var(--fg-soft);
  }
  .origin-body :global(h2) {
    margin: 52px 0 16px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    font-size: clamp(21px, 2.4vw, 27px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--fg);
    text-wrap: balance;
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .origin-body :global(h3) {
    margin: 32px 0 10px;
    font-size: 17px;
    font-weight: 600;
    color: var(--fg);
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .origin-body :global(p) { margin: 0 0 18px; }
  .origin-body :global(strong) { color: var(--fg); font-weight: 600; }
  .origin-body :global(ul), .origin-body :global(ol) {
    margin: 0 0 18px;
    padding-left: 22px;
  }
  .origin-body :global(li) { margin: 6px 0; }
  .origin-body :global(a) {
    color: var(--accent-fg);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 40%, transparent);
    text-underline-offset: 2px;
  }
  .origin-body :global(a:hover) { color: var(--accent); }
  .origin-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  /* The quoted messages are the evidence in this piece, so they read as
     testimony rather than as an aside: larger than the body, not smaller. */
  .origin-body :global(blockquote) {
    margin: 24px 0;
    padding: 2px 0 2px 20px;
    border-left: 2px solid var(--accent);
    color: var(--fg);
    font-size: 17px;
    line-height: 1.6;
  }
  .origin-body :global(blockquote p) { margin: 0 0 10px; }
  .origin-body :global(blockquote p:last-child) { margin-bottom: 0; }
  /* width/height on the tag give the ratio; these keep it inside the column. */
  .origin-body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .origin-body :global(p:has(> img)) { margin: 0 0 36px; }
  .origin-body :global(.origin-diagram) {
    width: min(100%, 560px);
    margin: 28px auto 40px;
  }
  .origin-body :global(.origin-flow) {
    color: var(--fg);
  }
  .origin-body :global(.origin-flow-sources) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .origin-body :global(.origin-flow-sources > div) {
    min-width: 0;
    padding: 11px 13px 12px;
  }
  .origin-body :global(.origin-flow-sources > div + div) {
    border-left: 1px solid var(--border);
  }
  .origin-body :global(.origin-flow-sources span),
  .origin-body :global(.origin-flow-node > span) {
    display: block;
    margin-bottom: 3px;
    color: var(--muted);
    font: 500 10.5px/1.35 var(--font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .origin-body :global(.origin-flow-sources strong),
  .origin-body :global(.origin-flow-node strong) {
    display: block;
    font-size: 14.5px;
    line-height: 1.4;
  }
  .origin-body :global(.origin-flow-arrow) {
    height: 27px;
    display: grid;
    place-items: center;
    color: var(--border-strong);
    font: 500 16px/1 var(--font-mono);
  }
  .origin-body :global(.origin-flow > .origin-flow-node) {
    width: 82%;
    margin: 0 auto;
  }
  .origin-body :global(.origin-flow-node) {
    padding: 11px 13px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .origin-body :global(.origin-flow-node--violet) {
    border-color: color-mix(in oklab, var(--violet) 28%, var(--border));
    background: var(--violet-soft);
  }
  .origin-body :global(.origin-flow-node--violet > span) { color: var(--violet); }
  .origin-body :global(.origin-flow-node--good) {
    border-color: color-mix(in oklab, var(--accent) 28%, var(--border));
    background: var(--accent-soft);
  }
  .origin-body :global(.origin-flow-node--good > span) { color: var(--accent-fg); }
  .origin-body :global(.origin-flow-node--warn) {
    border-color: color-mix(in oklab, var(--warn) 32%, var(--border));
    background: var(--warn-soft);
  }
  .origin-body :global(.origin-flow-node--warn > span) { color: var(--warn-fg); }
  .origin-body :global(.origin-flow-divider) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 13px 0;
    color: var(--muted);
    font: 500 10.5px/1.35 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .origin-body :global(.origin-flow-divider::before),
  .origin-body :global(.origin-flow-divider::after) {
    content: '';
    height: 1px;
    flex: 1;
    background: var(--border);
  }
  .origin-body :global(.origin-flow-outcomes) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .origin-body :global(.origin-activation) {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .origin-body :global(.origin-activation-path) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18px minmax(0, 1fr) 18px minmax(0, 1fr) 18px minmax(0, 1fr);
    align-items: stretch;
  }
  .origin-body :global(.origin-activation-path > div) {
    min-width: 0;
    padding: 13px 10px;
  }
  .origin-body :global(.origin-activation-path strong) {
    display: block;
    color: var(--fg);
    font: 600 20px/1.1 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .origin-body :global(.origin-activation-path span) {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.35;
  }
  .origin-body :global(.origin-activation-path i) {
    display: grid;
    place-items: center;
    color: var(--border-strong);
    font: 400 14px/1 var(--font-mono);
    font-style: normal;
  }
  .origin-body :global(.origin-activation-path i::before) { content: '→'; }
  .origin-body :global(.origin-activation-result) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 12px;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
  }
  .origin-body :global(.origin-activation-result span) {
    color: var(--muted);
    font: 500 10.5px/1.35 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .origin-body :global(.origin-activation-result strong) {
    color: var(--fg);
    font: 600 15px/1 var(--font-mono);
  }
  .origin-body :global(.origin-stepper) {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .origin-body :global(.origin-stepper-header) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .origin-body :global(.origin-stepper-header > span) {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .origin-body :global(.origin-stepper-header small),
  .origin-body :global(.origin-stepper-step > span) {
    color: var(--muted);
    font: 600 9px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .origin-body :global(.origin-stepper-header strong) {
    color: var(--fg);
    font-size: 13px;
    line-height: 1.3;
  }
  .origin-body :global(.origin-stepper-header output) {
    flex: 0 0 auto;
    color: var(--muted);
    font: 600 10px/1.3 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .origin-body :global(.origin-stepper-stage) {
    display: grid;
    min-height: 205px;
    align-items: center;
    padding: 20px;
  }
  .origin-body :global(.origin-stepper-step) {
    --step-accent: var(--accent-fg);
    margin: 0;
    padding: 0;
  }
  .origin-body :global(.origin-stepper-step--violet) { --step-accent: var(--violet); }
  .origin-body :global(.origin-stepper-step--good) { --step-accent: var(--accent-fg); }
  .origin-body :global(.origin-stepper-step > span) { color: var(--step-accent); }
  .origin-body :global(.origin-stepper-step > strong) {
    display: block;
    max-width: 31rem;
    margin-top: 7px;
    color: var(--fg);
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .origin-body :global(.origin-stepper-step > p) {
    max-width: 32rem;
    margin: 8px 0 0;
    color: var(--fg-soft);
    font-size: 13px;
    line-height: 1.55;
  }
  .origin-body :global(.origin-stepper-step > ul) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .origin-body :global(.origin-stepper-step > ul > li) {
    margin: 0;
    padding: 4px 7px;
    border: 1px solid color-mix(in oklab, var(--step-accent) 25%, var(--border));
    border-radius: 999px;
    background: color-mix(in oklab, var(--step-accent) 5%, var(--surface));
    color: var(--fg-soft);
    font: 500 9.5px/1.25 var(--font-mono);
  }
  .origin-body :global(.origin-stepper-footer) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 9px 12px;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
  }
  .origin-body :global(.origin-stepper-progress) {
    display: flex;
    flex: 1 1 120px;
    gap: 4px;
    max-width: 145px;
  }
  .origin-body :global(.origin-stepper-progress i) {
    display: block;
    flex: 1;
    height: 3px;
    border-radius: 999px;
    background: var(--border);
    transition: background-color 140ms ease;
  }
  .origin-body :global(.origin-stepper-progress i.is-active) { background: var(--accent); }
  .origin-body :global(.origin-stepper-controls) {
    display: flex;
    flex: 0 0 auto;
    gap: 6px;
  }
  .origin-body :global(.origin-stepper-controls button) {
    min-height: 34px;
    padding: 0 10px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    color: var(--fg-soft);
    font: 600 9.5px/1 var(--font-mono);
    cursor: pointer;
  }
  .origin-body :global(.origin-stepper-controls button:hover:not(:disabled)) {
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .origin-body :global(.origin-stepper-controls button:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .origin-body :global(.origin-stepper-controls button:disabled) {
    opacity: 0.38;
    cursor: default;
  }
  .origin-body :global(.origin-stepper-limit) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin: 8px 0 0;
    color: var(--muted);
    font: 400 10px/1.45 var(--font-mono);
  }
  .origin-body :global(.origin-stepper-limit code) {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: inherit;
  }
  .origin-body :global(.origin-diagram figcaption) {
