    .origin-body :global(.origin-stepper-progress) { max-width: 72px; }
    .origin-body :global(.origin-stepper-controls button) {
      min-height: 44px;
      padding: 0 9px;
    }
  }
</style>

<script>
  // Clickable index: mark the section currently in view.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.es-toc a[href^="#"]'));
  const sections = links
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((el): el is HTMLElement => el !== null);

  if (links.length > 0 && sections.length > 0 && 'IntersectionObserver' in window) {
    const visible = new Set<string>();

    const setActive = (id: string | null) => {
      for (const link of links) {
        const isCurrent = id !== null && decodeURIComponent(link.hash.slice(1)) === id;
        if (isCurrent) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        const first = sections.find((section) => visible.has(section.id));
        if (first) setActive(first.id);
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    for (const section of sections) observer.observe(section);
  }

  for (const stepper of document.querySelectorAll<HTMLElement>('[data-origin-stepper]')) {
    const steps = Array.from(stepper.querySelectorAll<HTMLElement>('[data-origin-step]'));
    const progress = Array.from(stepper.querySelectorAll<HTMLElement>('.origin-stepper-progress i'));
    const count = stepper.querySelector<HTMLOutputElement>('[data-origin-stepper-count]');
    const previous = stepper.querySelector<HTMLButtonElement>('[data-origin-stepper-prev]');
    const next = stepper.querySelector<HTMLButtonElement>('[data-origin-stepper-next]');

    if (steps.length === 0 || !count || !previous || !next) continue;

    let current = 0;
    const renderStep = () => {
      for (const [index, step] of steps.entries()) step.hidden = index !== current;
      for (const [index, segment] of progress.entries()) {
        segment.classList.toggle('is-active', index <= current);
      }
      count.textContent = `${current + 1} / ${steps.length}`;
      previous.disabled = current === 0;
      next.disabled = current === steps.length - 1;
    };

    previous.addEventListener('click', () => {
      current = Math.max(0, current - 1);
      renderStep();
    });
    next.addEventListener('click', () => {
      current = Math.min(steps.length - 1, current + 1);
      renderStep();
    });

    renderStep();
  }
</script>
