    .origin-body { font-size: 15.5px; padding-top: 32px; }
    .origin-body :global(blockquote) { font-size: 16px; }
    .origin-body :global(.origin-activation-path) { grid-template-columns: 1fr; }
    .origin-body :global(.origin-activation-path > div) { padding: 11px 12px; }
