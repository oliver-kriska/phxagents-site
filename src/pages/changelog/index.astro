---
import ChangelogPage from '../../components/ChangelogPage.astro';
import { stats } from '../../data/stats';
import { getChangelogMajors, getChangelogPreamble } from '../../lib/changelog';

// The current major and Unreleased; earlier majors live at /changelog/v<n>/.
const [current] = getChangelogMajors();
---

<ChangelogPage
  major={current}
  title="Changelog"
  description={`Release notes for the phxagents plugin, ${current.label} to the current v${stats.version}, with every earlier major one click away.`}
  introMarkdown={getChangelogPreamble()}
>
  <Fragment slot="lede">
    Release notes for the <code>elixir-phoenix</code> plugin. Current version <strong>v{stats.version}</strong>. Source: <a href="https://github.com/oliver-kriska/claude-elixir-phoenix/blob/main/CHANGELOG.md" rel="noopener">CHANGELOG.md</a>.
  </Fragment>
</ChangelogPage>
