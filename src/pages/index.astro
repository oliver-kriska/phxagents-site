---
import Default from '../layouts/Default.astro';
import { stats } from '../data/stats';
import { hookGroupPages, hookDocUrl } from '../lib/hookDocs';
import { getLatestRelease } from '../data/release';
import { getPortableWorkflowNames } from '../lib/skillNames';
import { getPlugin, RUNTIME_LABELS } from '../lib/plugins';

const runtimes = getPlugin('elixir-phoenix').runtimes;
const generatedEditions = runtimes.filter((runtime) => runtime !== 'claude-code').length;
const runtimeNames = new Intl.ListFormat('en', { type: 'conjunction' }).format(
  runtimes.map((runtime) => RUNTIME_LABELS[runtime])
);
const release = await getLatestRelease();
const releaseTag = `v${stats.version}`;
const releaseMatchesManifest = release?.tag_name === releaseTag;
const releaseUrl = releaseMatchesManifest ? release!.html_url : '/changelog/';
const adaptedWorkflows = getPortableWorkflowNames().length;
// Kept under ~160 characters so a search result shows it whole.
const metaDescription = `phxagents v3: one Elixir and Phoenix skill set for ${runtimeNames}, with ${adaptedWorkflows} workflows adapted to each.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'phxagents',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  description: metaDescription,
  url: 'https://phxagents.dev',
  softwareVersion: stats.version,
  license: 'https://opensource.org/licenses/MIT',
  author: {
    '@type': 'Person',
    name: 'Oliver Kriška',
    url: 'https://github.com/oliver-kriska',
  },
  codeRepository: 'https://github.com/oliver-kriska/claude-elixir-phoenix',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<Default
  title="Elixir & Phoenix skills for AI coding agents"
  description={metaDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">
            <span class="dot"></span>
            <a href={releaseUrl} rel={releaseUrl.startsWith('http') ? 'noopener' : undefined}>{releaseTag}</a> · {runtimes.length} runtime editions
          </div>
          <h1 class="headline">
            One Phoenix playbook. {runtimes.length} AI coding runtimes.
          </h1>
          <p class="lede">
            <strong>Plausible Elixir is not idiomatic Phoenix.</strong> {stats.skills} skills for every runtime. Claude Code adds {stats.agents} specialist agents and {stats.hooks} enforcement hooks.
          </p>

          <div class="hero-cta">
            <a class="btn-primary" href="/install/">
              Choose your runtime
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a class="btn-ghost" href="/catalog/">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              Browse the catalog
            </a>
          </div>
        </div>

        <figure class="hero-proof">
          <figcaption>Claude Code · safety gate example</figcaption>
          <div class="proof-body">
            <div class="proof-command"><span>Bash</span><code>mix ecto.reset</code></div>
            <p class="proof-response"><samp>BLOCKED: Destructive database operation detected.</samp></p>
          </div>
          <p class="proof-note">In a project with <code>mix.exs</code>, the hook stops this command before it runs. <a href="/hooks/safety-gates/">Read the safety gate →</a></p>
        </figure>
      </div>
    </div>
  </section>

  <section class="band band-stats">
    <div class="wrap">
      <div class="stats numeric">
        <a class="stat" href="/catalog/?type=skill&amp;plugin=elixir-phoenix"><div class="n">{stats.skills}</div><div class="lbl">Canonical skills</div></a>
        <a class="stat" href="/catalog/?type=agent&amp;plugin=elixir-phoenix"><div class="n">{stats.agents}</div><div class="lbl">Claude Code agents</div></a>
        <a class="stat" href="#workflow"><div class="n">{adaptedWorkflows}</div><div class="lbl">Workflows adapted</div></a>
        <a class="stat" href="/iron-laws/"><div class="n">{stats.ironLaws}</div><div class="lbl">Iron Laws</div></a>
        <a class="stat" href="/hooks/"><div class="n">{stats.hooks}</div><div class="lbl">Enforcement hooks</div></a>
        <a class="stat" href="/hooks/"><div class="n">{stats.hookEvents}</div><div class="lbl">Lifecycle events</div></a>
      </div>
      <p class="stats-note">
        Counts read from source at build time. See what gets used in <a href="/origin/">the origin story</a>, and how findable the wider Elixir ecosystem is to AI tools in <a href="/research/elixir-retrieval-gap/">the retrieval-gap study</a>.
      </p>
    </div>
  </section>

  <section class="band band-features">
    <div class="wrap">
      <div class="section-head">
        <h2>What changed in v3.</h2>
        <p>The release is broader than renamed commands. Canonical skills are projected into native package shapes, core workflows are rewritten around each runtime’s tools, and unsupported Claude-only capabilities stay explicit.</p>
      </div>

      <div class="features">
        <article class="feature feature--featured">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
          </span>
          <h3>{stats.skills} skills, generated {generatedEditions} ways</h3>
          <p>Amp, Codex, Pi, OpenCode and DeepSeek Harness receive deterministic projections of the canonical Claude skills, including complete resource trees, non-Markdown files and executable modes.</p>
          <ul class="feature-tags">
            <li>Amp Agent Skills</li>
            <li>Codex plugin</li>
            <li>Pi package</li>
            <li>OpenCode tree</li>
            <li>dsh tree</li>
          </ul>
          <div class="meta">one source · golden snapshots · mode-aware drift checks</div>
        </article>

        <article class="feature feature--featured">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18"/><path d="M3 6h18"/><path d="M3 18h18"/></svg>
          </span>
          <h3>{adaptedWorkflows} workflows adapted, not merely renamed</h3>
          <p>Each keeps its real contract—artifacts, read-only review, user gates, resumable progress and verification—with optional native workers and a complete sequential fallback.</p>
          <ul class="feature-tags">
            <li>investigate + review</li>
            <li>plan + work</li>
            <li>PR review + full</li>
            <li>trace + audit + research</li>
          </ul>
          <div class="meta">portable overlays · no hidden parity claims</div>
        </article>

        <article class="feature">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
          </span>
          <h3>Claude orchestration stays native</h3>
          <p>Claude Code remains the full plugin: {stats.agents} named agents, <a href="/hooks/">{stats.hooks} lifecycle hooks</a>, permission settings, root instructions and its specialist fan-out.</p>
          <div class="meta">full canonical implementation</div>
        </article>

        <article class="feature">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
          </span>
          <h3>Client payloads are untrusted</h3>
          <p>New LiveView guidance treats <code>phx-value-*</code>, form and hook payloads as user-controlled. Exposed IDs are not flaws by themselves; every event must authorize against server-side state.</p>
          <div class="meta">client boundary · server-side authorization</div>
        </article>

        <article class="feature">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M9 4v16"/><path d="m12 12 2 2 3-4"/></svg>
          </span>
          <h3>Runtime-honest safety</h3>
          <p>Generated targets never pretend Claude hooks or named agents are installed. Codex alone gains an optional, trust-gated destructive-command safeguard; other enforcement remains deferred.</p>
          <div class="meta"><a href="/compatibility/">capability matrix →</a></div>
        </article>

        <article class="feature">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M8 9h8"/><path d="M8 13h5"/></svg>
          </span>
          <h3>Learned fixes become real skills</h3>
          <p><code>/phx:learn-from-fix</code> can now save package-specific lessons as native personal or project skills, with locked-version lookup and safe shadowing checks.</p>
          <div class="meta">package knowledge · personal or project scope</div>
        </article>
      </div>
    </div>
  </section>

  <section class="band band-workflow" id="workflow">
    <div class="wrap">
      <div class="section-head">
        <h2>The portable workflow layer.</h2>
        <p>These are the workflows v3 explicitly adapts across every generated runtime. Other skills still ship as useful domain guidance, but may retain Claude-specific orchestration references.</p>
      </div>

      <div class="workflow">
        <ul>
          <li>
            <div>
              <strong>Investigate + review</strong>
              <p>Reproduce before fixing; review changed files without mutating them. Run independent tracks with native workers or sequentially.</p>
            </div>
            <a class="cmd-inline" href="/skills/investigate/">phx-investigate</a>
          </li>
          <li>
            <div>
              <strong>Plan + work</strong>
              <p>Keep the canonical plan schema, scratchpad research, task checkboxes and resumable <code>progress.md</code>.</p>
            </div>
            <a class="cmd-inline" href="/skills/plan/">phx-plan</a>
          </li>
          <li>
            <div>
              <strong>PR review + full</strong>
              <p>Preserve read-only triage, explicit mutation approval, bounded retries and the complete gated lifecycle.</p>
            </div>
            <a class="cmd-inline" href="/skills/pr-review/">phx-pr-review</a>
          </li>
          <li>
            <div>
              <strong>Trace + audit + research</strong>
              <p>Use direct <code>mix xref</code>, five health tracks, and native web or HTTP tools with local-source fallbacks.</p>
            </div>
            <a class="cmd-inline" href="/skills/audit/">phx-audit</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="band band-hooks" id="hooks">
    <div class="wrap">
      <div class="section-head">
        <h2>The layer that doesn’t rely on being read.</h2>
        <p>Skills and agents are instructions a model may or may not follow. Hooks are shell scripts that always run. Session analysis across 400 sessions measured <code>CLAUDE.md</code> prose rules firing <strong>~0% of the time</strong> — so anything that genuinely must happen moved out of prose and into {stats.hooks} auditable bash scripts across {stats.hookEvents} lifecycle events.</p>
      </div>

      <div class="hooks-grid">
        <div class="term" aria-hidden="true">
          <div class="term-head">
            <div class="traffic" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="title">PreToolUse · block-dangerous-ops</div>
          </div>
          <div class="term-body">
            <div class="term-line"><span class="prompt">$</span><span class="cmd">git push --force</span></div>
            <div class="term-out"><span class="warn">BLOCKED: Force push detected — this rewrites remote history.</span>
If intentional, run manually outside Claude Code.
<span class="dim">Safer alternative: git push --force-with-lease</span></div>
          </div>
        </div>

        <ul class="hooks-list">
          {hookGroupPages.map((group) => (
            <li>
              <a href={hookDocUrl(group.slug)}>
                <strong>{group.navLabel}</strong>
                <span class="ev">{group.events.join(' · ')}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <p class="hooks-note">
        Every Elixir-specific hook gates on <code>mix.exs</code>, so in a non-Elixir repository
        only the force-push block stays on, and all of them fail open — a broken hook means the guard is off,
        never that the session is unusable.
        <a href="/hooks/">Read how the hooks work →</a>
      </p>
    </div>
  </section>

  <section class="band band-clients" id="clients">
    <div class="wrap">
      <div class="section-head">
        <h2>Choose the runtime you already use.</h2>
        <p>Every edition ships the same canonical skill knowledge. Packaging, invocation, hooks, custom agents and MCP setup follow each runtime’s real capabilities—not a lowest-common-denominator promise. Live SQL and runtime introspection come from <a href="/tidewave-mcp/">Tidewave MCP</a> wherever your client registers it; adapted workflows fall back to local tools without it.</p>
      </div>

      <div class="clients">
        <a class="client" href="/install/#claude-code">
          <span class="client-mark">CC</span>
          <div>
            <div class="name">Claude Code</div>
            <div class="stat-row">
              <span class="ok">● full plugin</span>
              <span>{stats.skills} skills · {stats.agents} agents</span>
            </div>
          </div>
        </a>
        <a class="client" href="/install/amp/">
          <span class="client-mark">A</span>
          <div>
            <div class="name">Amp</div>
            <div class="stat-row">
              <span class="ok">● skills edition</span>
              <span>{stats.skills} skills</span>
            </div>
          </div>
        </a>
        <a class="client" href="/install/codex/">
          <span class="client-mark">CX</span>
          <div>
            <div class="name">Codex</div>
            <div class="stat-row">
              <span class="ok">● skills edition</span>
              <span>{stats.skills} skills</span>
            </div>
          </div>
        </a>
        <a class="client" href="/install/pi/">
          <span class="client-mark">π</span>
          <div>
            <div class="name">Pi</div>
            <div class="stat-row">
              <span class="ok">● skills edition</span>
              <span>{stats.skills} skills</span>
            </div>
          </div>
        </a>
        <a class="client" href="/install/opencode/">
          <span class="client-mark">OC</span>
          <div>
            <div class="name">OpenCode</div>
            <div class="stat-row">
              <span class="ok">● skills edition</span>
              <span>{stats.skills} skills</span>
            </div>
          </div>
        </a>
        <a class="client" href="/install/dsh/">
          <span class="client-mark">DS</span>
          <div>
            <div class="name">DeepSeek Harness</div>
            <div class="stat-row">
              <span class="ok">● skills edition</span>
              <span>{stats.skills} skills</span>
            </div>
          </div>
        </a>
      </div>
      <p class="plugins-note">
        Looking beyond the core plugin? <a href="/plugins/">Explore the plugin collection →</a>
        Each plugin lists its own runtime support and installation requirements.
      </p>
    </div>
  </section>

  <section class="band band-cta">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Install v3 for your runtime.</h2>
          <p>Choose the runtime you already use. If hooks or multi-agent orchestration matter to your workflow, <a href="/compatibility/">compare support first</a>.</p>
        </div>
        <div class="actions">
          <a class="btn-primary" href="/install/">Choose runtime</a>
          <a class="btn-ghost" href="/catalog/">Browse catalog</a>
        </div>
      </div>
    </div>
  </section>
</Default>

<style>
  .hero {
    padding: 72px 0 52px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 18px;
  }
  .eyebrow .dot {
    width: 6px; height: 6px; border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 20%, transparent);
  }
  .eyebrow a { color: inherit; border-bottom: 1px dashed transparent; transition: color 120ms, border-color 120ms; }
  .eyebrow a:hover { color: var(--fg); border-bottom-color: var(--muted); }
  h1.headline {
    font-size: clamp(34px, 4.8vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin: 0 0 18px;
    color: var(--fg);
    text-wrap: balance;
  }
  .lede {
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--fg-soft);
    max-width: 540px;
    margin: 0 0 28px;
  }
  .hero-cta {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-cta .btn-primary, .hero-cta .btn-ghost { height: 38px; padding: 0 16px; font-size: 13.5px; }

  .hero-proof {
    min-width: 0;
    margin: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }
  .hero-proof figcaption {
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--muted);
    font-size: 13px;
  }
  .proof-body { padding: 24px 20px; }
  .proof-command { display: flex; align-items: baseline; gap: 16px; }
  .proof-command span { color: var(--muted); font: 12px var(--font-mono); }
  .proof-command code { color: var(--fg); font: 14px var(--font-mono); }
  .proof-response { margin: 18px 0 0; color: var(--warn-fg); }
  .proof-response samp { font: 13px/1.65 var(--font-mono); }
  .proof-note {
    margin: 0;
    padding: 14px 20px;
    border-top: 1px solid var(--border);
    color: var(--fg-soft);
    font-size: 13px;
    line-height: 1.6;
  }
  .proof-note a { color: var(--accent-fg); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }

  /* Terminal */
  .term {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .term-head {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 36px;
    padding: 0 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 11.5px;
  }
  .term-head .traffic { display: flex; gap: 6px; }
  .term-head .traffic i {
    width: 11px; height: 11px; border-radius: 999px;
    background: var(--border-strong);
  }
  .term-head .title { margin-left: 8px; font-size: 11.5px; }
  .term-body { padding: 16px 18px 20px; line-height: 1.65; }
  .term-line { display: flex; gap: 8px; }
  .term-line .prompt { color: var(--accent); user-select: none; }
  .term-line .cmd { color: var(--fg); min-width: 0; overflow-wrap: anywhere; }
  .term-out { color: var(--fg-soft); padding-left: 18px; white-space: pre-wrap; font-size: 11.5px; }
  .term-out .ok { color: var(--accent); }
  .term-out .warn { color: var(--warn-fg); }
  .term-out .info { color: var(--info-fg); }
  .term-out .dim { color: var(--muted); }

  /* Hooks */
  .hooks-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .hooks-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }
  .hooks-list li + li { border-top: 1px solid var(--border); }
  .hooks-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 18px;
    text-decoration: none;
    color: inherit;
    transition: background 120ms;
  }
  .hooks-list a:hover { background: var(--surface-2); }
  .hooks-list a:hover strong { color: var(--accent-fg); }
  .hooks-list strong { font-size: 13.5px; font-weight: 600; color: var(--fg); }
  .hooks-list .ev {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .hooks-note, .plugins-note {
    margin: 24px 0 0;
    max-width: 760px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted);
  }
  .hooks-note a, .plugins-note a {
    color: var(--accent-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 900px) {
    .hooks-grid { grid-template-columns: 1fr; }
  }

  /* Section bands — deliberately uneven rhythm (not a repeated 64px stamp):
     denser sections get more air, the closing CTA gets the most emphasis. */
  section.band {
    padding: 64px 0;
    border-top: 1px solid var(--border);
  }
  section.band-stats { padding: 0 0 48px; border-top: 0; }
  section.band-features { padding: 72px 0; }
  section.band-workflow { padding: 64px 0; }
  section.band-hooks { padding: 68px 0; }
  section.band-clients { padding: 56px 0; }
  section.band-cta { padding: 80px 0; }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 32px;
  }
  .section-head h2 {
    font-size: clamp(24px, 2.8vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
    color: var(--fg);
    font-weight: 600;
    text-wrap: balance;
  }
  .section-head p {
    color: var(--muted);
    max-width: 640px;
    margin: 4px 0 0;
    font-size: 14px;
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-block: 1px solid var(--border);
    padding: 8px 0;
    gap: 0 24px;
  }
  .stat {
    min-height: 44px;
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .stat:hover .lbl { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
  .stat .n {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .stat .lbl {
    font-size: 13px;
    color: var(--muted);
  }
  .stats-note {
    margin: 14px 0 0;
    max-width: 640px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted);
  }
  .stats-note a {
    color: var(--accent-fg);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 40%, transparent);
    text-underline-offset: 2px;
  }
