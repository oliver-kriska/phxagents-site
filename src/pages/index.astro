---
import Default from '../layouts/Default.astro';
import { stats } from '../data/stats';
import { getLatestRelease } from '../data/release';
import { getPortableWorkflowNames } from '../lib/skillNames';

const release = await getLatestRelease();
const releaseTag = `v${stats.version}`;
const releaseMatchesManifest = release?.tag_name === releaseTag;
const releaseUrl = releaseMatchesManifest ? release!.html_url : '/changelog/';
const releaseStateLabel = releaseMatchesManifest ? 'five runtimes shipped' : 'five runtime editions';
const adaptedWorkflows = getPortableWorkflowNames().length;
const metaDescription = `phxagents v3 brings one canonical Elixir and Phoenix skill set to Claude Code, Amp, Codex, Pi, and OpenCode, with ${adaptedWorkflows} workflows adapted for every runtime.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'phxagents',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  description: stats.description,
  url: 'https://phxagents.dev',
  softwareVersion: stats.version,
  license: 'https://opensource.org/licenses/MIT',
  author: {
    '@type': 'Person',
    name: 'Oliver Kriška',
    url: 'https://github.com/oliver-kriska',
  },
  codeRepository: 'https://github.com/oliver-kriska/claude-elixir-phoenix',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<Default
  title="Elixir & Phoenix skills for AI coding agents"
  description={metaDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">
            <span class="dot"></span>
            <a href={releaseUrl} rel={releaseUrl.startsWith('http') ? 'noopener' : undefined}>{releaseTag}</a> · {releaseStateLabel}
          </div>
          <h1 class="headline">
            One Phoenix playbook. Five AI coding runtimes.
          </h1>
          <p class="lede">
            <strong>Plausible Elixir is not idiomatic Phoenix.</strong> phxagents v3 gives Claude Code, Amp, Codex, Pi and OpenCode the same {stats.skills}-skill field manual. Claude Code also gets the full {stats.agents}-agent, hooks and orchestration layer.
          </p>

          <div class="hero-cta">
            <a class="btn-primary" href="/install/">
              Choose your runtime
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a class="btn-ghost" href="/catalog/">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              Browse the catalog
            </a>
          </div>
        </div>

        <div class="term" aria-hidden="true">
          <div class="term-head">
            <div class="traffic" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="title">phxagents v3 · runtime map</div>
          </div>
          <div class="term-body">
            <div class="term-line"><span class="prompt">v3</span><span class="cmd">one canonical source → five native distributions</span></div>
            <div class="term-out">
<span class="dim">canonical</span>  <span class="info">Claude Code</span>  /phx:review
<span class="dim">generated</span>  <span class="info">Amp</span>          skill: invoke → phx-review
<span class="dim">generated</span>  <span class="info">Codex</span>        $elixir-phoenix:phx-review
<span class="dim">generated</span>  <span class="info">Pi</span>           /skill:phx-review
<span class="dim">generated</span>  <span class="info">OpenCode</span>     skill tool → name: "phx-review"</div>

            <div class="term-line" style="margin-top:14px"><span class="prompt">✓</span><span class="cmd">{stats.skills} skills · {adaptedWorkflows} adapted workflows · drift checked</span><span class="term-cursor"></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band band-stats">
    <div class="wrap">
      <div class="stats numeric">
        <a class="stat" href="/catalog/?type=skill"><div class="n">{stats.skills}</div><div class="lbl">Canonical skills</div></a>
        <a class="stat" href="/catalog/?type=agent"><div class="n">{stats.agents}</div><div class="lbl">Claude Code agents</div></a>
        <a class="stat" href="#workflow"><div class="n">{adaptedWorkflows}</div><div class="lbl">Workflows adapted</div></a>
        <a class="stat" href="/iron-laws/"><div class="n">{stats.ironLaws}</div><div class="lbl">Iron Laws</div></a>
      </div>
    </div>
  </section>

  <section class="band band-features">
    <div class="wrap">
      <div class="section-head">
        <h2>What changed in v3.</h2>
        <p>The release is broader than renamed commands. Canonical skills are projected into native package shapes, core workflows are rewritten around each runtime’s tools, and unsupported Claude-only capabilities stay explicit.</p>
      </div>

      <div class="features">
        <article class="feature feature--featured">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
          </span>
          <h3>{stats.skills} skills, generated four ways</h3>
          <p>Amp, Codex, Pi and OpenCode receive deterministic projections of the canonical Claude skills, including complete resource trees, non-Markdown files and executable modes.</p>
          <ul class="feature-tags">
            <li>Amp Agent Skills</li>
            <li>Codex plugin</li>
            <li>Pi package</li>
            <li>OpenCode tree</li>
          </ul>
          <div class="meta">one source · golden snapshots · mode-aware drift checks</div>
        </article>

        <article class="feature feature--featured">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18"/><path d="M3 6h18"/><path d="M3 18h18"/></svg>
          </span>
          <h3>{adaptedWorkflows} workflows adapted, not merely renamed</h3>
          <p>Each keeps its real contract—artifacts, read-only review, user gates, resumable progress and verification—with optional native workers and a complete sequential fallback.</p>
          <ul class="feature-tags">
            <li>investigate + review</li>
            <li>plan + work</li>
            <li>PR review + full</li>
            <li>trace + audit + research</li>
          </ul>
          <div class="meta">portable overlays · no hidden parity claims</div>
        </article>

        <article class="feature">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
          </span>
          <h3>Claude orchestration stays native</h3>
          <p>Claude Code remains the full plugin: {stats.agents} named agents, lifecycle hooks, permission settings, root instructions and its specialist fan-out.</p>
          <div class="meta">full canonical implementation</div>
        </article>

        <article class="feature">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
          </span>
          <h3>Iron&nbsp;Laws still hold</h3>
          <p>{stats.ironLaws} non-negotiable Elixir and Phoenix rules remain the shared engineering judgment: no Repo calls in loops, bare rescue, untyped Oban args or missing authorization.</p>
          <div class="meta">guardrails before generated code</div>
        </article>

        <article class="feature">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M9 4v16"/><path d="m12 12 2 2 3-4"/></svg>
          </span>
          <h3>Runtime-honest safety</h3>
          <p>Generated targets never pretend Claude hooks or named agents are installed. Codex alone gains an optional, trust-gated destructive-command safeguard; other enforcement remains deferred.</p>
          <div class="meta"><a href="/compatibility/">capability matrix →</a></div>
        </article>

        <article class="feature">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M8 9h8"/><path d="M8 13h5"/></svg>
          </span>
          <h3>Learned fixes become real skills</h3>
          <p><code>/phx:learn-from-fix</code> can now save package-specific lessons as native personal or project skills, with locked-version lookup and safe shadowing checks.</p>
          <div class="meta">package knowledge · personal or project scope</div>
        </article>
      </div>
    </div>
  </section>

  <section class="band band-workflow" id="workflow">
    <div class="wrap">
      <div class="section-head">
        <h2>The portable workflow layer.</h2>
        <p>These are the workflows v3 explicitly adapts across every generated runtime. Other skills still ship as useful domain guidance, but may retain Claude-specific orchestration references.</p>
      </div>

      <div class="workflow">
        <ul>
          <li>
            <div>
              <strong>Investigate + review</strong>
              <p>Reproduce before fixing; review changed files without mutating them. Run independent tracks with native workers or sequentially.</p>
            </div>
            <a class="cmd-inline" href="/skills/investigate/">phx-investigate</a>
          </li>
          <li>
            <div>
              <strong>Plan + work</strong>
              <p>Keep the canonical plan schema, scratchpad research, task checkboxes and resumable <code>progress.md</code>.</p>
            </div>
            <a class="cmd-inline" href="/skills/plan/">phx-plan</a>
          </li>
          <li>
            <div>
              <strong>PR review + full</strong>
              <p>Preserve read-only triage, explicit mutation approval, bounded retries and the complete gated lifecycle.</p>
            </div>
            <a class="cmd-inline" href="/skills/pr-review/">phx-pr-review</a>
          </li>
          <li>
            <div>
              <strong>Trace + audit + research</strong>
              <p>Use direct <code>mix xref</code>, five health tracks, and native web or HTTP tools with local-source fallbacks.</p>
            </div>
            <a class="cmd-inline" href="/skills/audit/">phx-audit</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="band band-clients" id="clients">
    <div class="wrap">
      <div class="section-head">
        <h2>Choose the runtime you already use.</h2>
        <p>Every edition ships the same canonical skill knowledge. Packaging, invocation, hooks, custom agents and MCP setup follow each runtime’s real capabilities—not a lowest-common-denominator promise.</p>
      </div>

      <div class="clients">
        <a class="client" href="/install/#claude-code">
          <span class="client-mark">CC</span>
          <div>
            <div class="name">Claude Code</div>
            <div class="stat-row">
              <span class="ok">● full plugin</span>
              <span>{stats.skills} skills · {stats.agents} agents</span>
            </div>
          </div>
        </a>
        <a class="client" href="/install/amp/">
          <span class="client-mark">A</span>
          <div>
            <div class="name">Amp</div>
            <div class="stat-row">
              <span class="ok">● skills edition</span>
              <span>{stats.skills} skills</span>
            </div>
          </div>
        </a>
        <a class="client" href="/install/codex/">
          <span class="client-mark">CX</span>
          <div>
            <div class="name">Codex</div>
            <div class="stat-row">
              <span class="ok">● skills edition</span>
              <span>{stats.skills} skills</span>
            </div>
          </div>
        </a>
        <a class="client" href="/install/pi/">
          <span class="client-mark">π</span>
          <div>
            <div class="name">Pi</div>
            <div class="stat-row">
              <span class="ok">● skills edition</span>
              <span>{stats.skills} skills</span>
            </div>
          </div>
        </a>
        <a class="client" href="/install/opencode/">
          <span class="client-mark">OC</span>
          <div>
            <div class="name">OpenCode</div>
            <div class="stat-row">
              <span class="ok">● skills edition</span>
              <span>{stats.skills} skills</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="band band-cta">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Install v3 for your runtime.</h2>
          <p>Choose the runtime you already use. If hooks or multi-agent orchestration matter to your workflow, <a href="/compatibility/">compare support first</a>.</p>
        </div>
        <div class="actions">
          <a class="btn-primary" href="/install/">Choose runtime</a>
          <a class="btn-ghost" href="/catalog/">Browse catalog</a>
        </div>
      </div>
    </div>
  </section>
</Default>

<style>
  .hero {
    padding: 72px 0 52px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 18px;
  }
  .eyebrow .dot {
    width: 6px; height: 6px; border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 20%, transparent);
  }
  .eyebrow a { color: inherit; border-bottom: 1px dashed transparent; transition: color 120ms, border-color 120ms; }
  .eyebrow a:hover { color: var(--fg); border-bottom-color: var(--muted); }
  h1.headline {
    font-size: clamp(34px, 4.8vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin: 0 0 18px;
    color: var(--fg);
    text-wrap: balance;
  }
  .lede {
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--fg-soft);
    max-width: 540px;
    margin: 0 0 28px;
  }
  .hero-cta {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-cta .btn-primary, .hero-cta .btn-ghost { height: 38px; padding: 0 16px; font-size: 13.5px; }

  /* Terminal */
  .term {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .term-head {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 36px;
    padding: 0 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 11.5px;
  }
  .term-head .traffic { display: flex; gap: 6px; }
  .term-head .traffic i {
    width: 11px; height: 11px; border-radius: 999px;
    background: var(--border-strong);
  }
  .term-head .title { margin-left: 8px; font-size: 11.5px; }
  .term-body { padding: 16px 18px 20px; line-height: 1.65; }
  .term-line { display: flex; gap: 8px; }
  .term-line .prompt { color: var(--accent); user-select: none; }
  .term-line .cmd { color: var(--fg); min-width: 0; overflow-wrap: anywhere; }
  .term-out { color: var(--fg-soft); padding-left: 18px; white-space: pre-wrap; font-size: 11.5px; }
  .term-out .ok { color: var(--accent); }
  .term-out .warn { color: var(--warn); }
  .term-out .info { color: var(--info-fg); }
  .term-out .dim { color: var(--muted); }
  .term-cursor::after {
    content: "▍";
    color: var(--accent);
    animation: blink 1.1s steps(2) infinite;
    margin-left: 2px;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* Section bands — deliberately uneven rhythm (not a repeated 64px stamp):
     denser sections get more air, the closing CTA gets the most emphasis. */
  section.band {
    padding: 64px 0;
    border-top: 1px solid var(--border);
  }
  section.band-stats { padding: 0 0 48px; border-top: 0; }
  section.band-features { padding: 72px 0; }
  section.band-workflow { padding: 64px 0; }
  section.band-clients { padding: 56px 0; }
  section.band-cta { padding: 80px 0; }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 32px;
  }
  .section-head h2 {
    font-size: clamp(24px, 2.8vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
    color: var(--fg);
    font-weight: 600;
    text-wrap: balance;
  }
  .section-head p {
    color: var(--muted);
    max-width: 640px;
    margin: 4px 0 0;
    font-size: 14px;
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }
  .stat {
    padding: 22px 24px;
    border-right: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: background 120ms, color 120ms;
    display: block;
  }
  .stat:last-child { border-right: 0; }
  @media (hover: hover) and (pointer: fine) {
    .stat:hover { background: var(--surface-2); }
    .stat:hover .n { color: var(--accent-fg); }
  }
  .stat .n {
    font-family: var(--font-mono);
    font-size: 28px;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .stat .lbl {
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
  }
  @media (max-width: 760px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(2) { border-right: 0; }
    .stat:nth-child(1), .stat:nth-child(2) { border-bottom: 1px solid var(--border); }
  }

  /* Features */
  .features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }
  .feature {
    padding: 28px 32px 30px 0;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 8px;
    align-content: start;
    border-bottom: 1px solid var(--border);
  }
  .feature:nth-child(odd) { border-right: 1px solid var(--border); }
  .feature:nth-child(even) { padding-right: 0; padding-left: 32px; }
  .feature--featured h3 { font-size: 17px; }
  .feature-tags {
    list-style: none;
    margin: 2px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .feature-tags li {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-soft);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 8px;
  }
  .feature-tags code {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
    color: var(--accent-fg);
  }
  .feature-icon {
    width: 36px; height: 36px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--border);
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--accent-fg);
    grid-column: 1;
    grid-row: 1 / span 4;
  }
  .feature-icon svg { width: 18px; height: 18px; }
  .feature h3,
  .feature p,
  .feature-tags,
  .feature .meta { grid-column: 2; }
  .feature h3 {
    margin: 0;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.005em;
  }
  .feature p {
    color: var(--fg-soft);
    margin: 0;
    font-size: 13.5px;
    line-height: 1.55;
  }
  .feature .meta {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .features { grid-template-columns: 1fr; }
    .feature,
    .feature:nth-child(even) { padding: 24px 0; }
    .feature:nth-child(odd) { border-right: 0; }
    .feature:last-child { border-bottom: 0; }
  }

  /* Workflow */
  .workflow {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }
  .workflow ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  .workflow ul li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
  }
  .workflow ul li:nth-child(odd) { border-right: 1px solid var(--border); }
  .workflow ul li:nth-child(-n + 2) { border-bottom: 1px solid var(--border); }
  .workflow ul li strong { color: var(--fg); font-weight: 600; font-size: 14px; display: block; }
  .workflow ul li p { margin: 2px 0 0; color: var(--muted); font-size: 12.5px; line-height: 1.5; }
  @media (max-width: 900px) {
    .workflow ul { grid-template-columns: 1fr; }
    .workflow ul li:nth-child(odd) { border-right: 0; }
    .workflow ul li:nth-child(-n + 3) { border-bottom: 1px solid var(--border); }
  }

  /* Clients */
  .clients {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 16px;
  }
  .client {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px 18px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
    transition: border-color 120ms, background 120ms;
  }
  .client:hover { border-color: var(--border-strong); background: var(--surface-2); color: inherit; }
  .client-mark {
    width: 36px; height: 36px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--border);
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent-fg);
  }
  .client .name { font-weight: 600; color: var(--fg); font-size: 14px; }
  .client .stat-row {
    display: flex; flex-wrap: wrap; gap: 4px 8px; margin-top: 3px;
    color: var(--muted); font-size: 11.5px; font-family: var(--font-mono);
  }
  .client .stat-row .ok { color: var(--accent-fg); }
  .client .stat-row a {
    color: inherit;
