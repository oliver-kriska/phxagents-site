---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const agents = await getCollection('agents');

const sorted = agents
  .map((entry) => ({
    slug: entry.id,
    name: entry.data.name,
    description: entry.data.description,
    model: entry.data.model,
    effort: entry.data.effort,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const tier = (model?: string) => {
  if (model === 'opus') return 'Orchestrators';
  if (model === 'haiku') return 'Mechanical';
  return 'Specialists';
};

const grouped: Record<string, typeof sorted> = {};
for (const agent of sorted) {
  const t = tier(agent.model);
  (grouped[t] ||= []).push(agent);
}

const tierOrder = ['Orchestrators', 'Specialists', 'Mechanical'];
const groups = tierOrder
  .filter((t) => grouped[t])
  .map((t) => ({ key: t, items: grouped[t]! }));
---

<StarlightPage
  frontmatter={{
    title: `${sorted.length} Agents`,
    description: 'Specialist agents in the phxagents plugin, grouped by tier.',
  }}
>
  <p>
    Each agent is a focused specialist with fresh context. Orchestrators
    coordinate parallel work. Specialists review one domain at a time.
    Mechanical agents handle compression and verification.
  </p>

  {
    groups.map(({ key, items }) => (
      <section>
        <h2>
          {key} · {items.length}
        </h2>
        <ul>
          {items.map((a) => (
            <li>
              <a href={`/agents/${a.slug}/`}>
                <strong>{a.name}</strong>
              </a>
              {a.model && (
                <span style="opacity: 0.6"> · {a.model}</span>
              )}
              {a.effort && (
                <span style="opacity: 0.6"> · {a.effort}</span>
              )}
              <br />
              <span style="opacity: 0.85">{a.description}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</StarlightPage>
