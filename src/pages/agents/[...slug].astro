---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../components/DocsLayout.astro';

export async function getStaticPaths() {
  const agents = await getCollection('agents');
  const sorted = [...agents].sort((a, b) =>
    a.data.name.localeCompare(b.data.name)
  );
  return sorted.map((entry, idx) => {
    const prev = idx > 0 ? sorted[idx - 1] : null;
    const next = idx < sorted.length - 1 ? sorted[idx + 1] : null;
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: prev ? { name: prev.data.name, slug: prev.id } : null,
        next: next ? { name: next.data.name, slug: next.id } : null,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { name, description, effort, model } = entry.data;
const rawTools = entry.data.tools;
const tools = Array.isArray(rawTools)
  ? rawTools.join(', ')
  : typeof rawTools === 'string'
  ? rawTools
  : undefined;
const sourceUrl = `https://github.com/oliver-kriska/claude-elixir-phoenix/blob/main/plugins/elixir-phoenix/agents/${entry.id}.md`;
const prevNav = prev ? { name: prev.name, href: `/agents/${prev.slug}/` } : null;
const nextNav = next ? { name: next.name, href: `/agents/${next.slug}/` } : null;
---

<DocsLayout
  title={name}
  description={description}
  kind="agent"
  name={name}
  slug={entry.id}
  effort={effort}
  model={model}
  tools={tools}
  sourceUrl={sourceUrl}
  prev={prevNav}
  next={nextNav}
>
  <Content />
</DocsLayout>
